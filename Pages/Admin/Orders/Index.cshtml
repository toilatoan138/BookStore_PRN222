@page
@model BookStore.Pages.Admin.Orders.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Đơn hàng";
    ViewData["Subtitle"] = "Theo dõi tiến độ giao vận, duyệt đơn và quản trị trạng thái bán hàng";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- SEARCH & STATUS TABS -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <form method="get" class="d-flex gap-2" style="max-width: 400px;">
            <input type="hidden" name="status" value="@Model.Status" />
            <input asp-for="Keyword" type="text" class="form-control form-control-sm" placeholder="Tìm theo mã đơn, tên khách, SĐT..." />
            <button type="submit" class="btn btn-sm btn-danger px-3">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.Keyword))
            {
                <a asp-page="/Admin/Orders/Index" asp-route-status="@Model.Status" class="btn btn-sm btn-outline-secondary px-2" title="Xóa tìm kiếm">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            }
        </form>

        <!-- STATUS TABS -->
        <div class="d-flex gap-1 overflow-auto">
            <a asp-page="/Admin/Orders/Index" asp-route-keyword="@Model.Keyword"
               class="btn btn-sm rounded-pill px-3 @(!Model.Status.HasValue ? "btn-danger fw-bold" : "btn-light text-dark border")">
                Tất cả (@Model.Orders.Count)
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Pending" asp-route-keyword="@Model.Keyword"
               class="btn btn-sm rounded-pill px-3 @(Model.Status == Models.Enums.OrderStatus.Pending ? "btn-danger fw-bold" : "btn-light text-dark border")">
                Chờ duyệt
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Processing" asp-route-keyword="@Model.Keyword"
               class="btn btn-sm rounded-pill px-3 @(Model.Status == Models.Enums.OrderStatus.Processing ? "btn-danger fw-bold" : "btn-light text-dark border")">
                Đang chuẩn bị
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Shipping" asp-route-keyword="@Model.Keyword"
               class="btn btn-sm rounded-pill px-3 @(Model.Status == Models.Enums.OrderStatus.Shipping ? "btn-danger fw-bold" : "btn-light text-dark border")">
                Đang giao
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Delivered" asp-route-keyword="@Model.Keyword"
               class="btn btn-sm rounded-pill px-3 @(Model.Status == Models.Enums.OrderStatus.Delivered ? "btn-danger fw-bold" : "btn-light text-dark border")">
                Đã giao
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Cancelled" asp-route-keyword="@Model.Keyword"
               class="btn btn-sm rounded-pill px-3 @(Model.Status == Models.Enums.OrderStatus.Cancelled ? "btn-danger fw-bold" : "btn-light text-dark border")">
                Đã hủy
            </a>
        </div>
    </div>

    <!-- ORDERS TABLE -->
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">Mã</th>
                    <th style="width: 140px;">Ngày đặt</th>
                    <th>Khách hàng</th>
                    <th class="text-center">Số sản phẩm</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 100px;">Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="fa-regular fa-folder-open fa-2x mb-2 d-block text-secondary"></i>
                            Không có đơn hàng nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="fw-bold">#@o.Id</td>
                            <td>@o.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-semibold text-dark">@o.FullName</div>
                                <small class="text-muted">@(o.PhoneNumber ?? "Chưa có SĐT")</small>
                            </td>
                            <td class="text-center">@o.Details.Sum(d => d.Quantity) quyển</td>
                            <td class="fw-bold text-danger">@o.TotalAmount.ToString("N0")đ</td>
                            <td>
                                <span class="badge @(o.PaymentMethod == "VNPAY" ? "bg-primary-subtle text-primary border border-primary-subtle" : o.PaymentMethod == "WALLET" ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-dark border")">
                                    @o.PaymentMethod
                                </span>
                            </td>
                            <td>
                                @if (o.Status == Models.Enums.OrderStatus.Delivered)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                        <i class="fa-solid fa-circle-check me-1"></i>Đã giao thành công
                                    </span>
                                }
                                else if (o.Status == Models.Enums.OrderStatus.Cancelled)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
                                        <i class="fa-solid fa-ban me-1"></i>Đã hủy
                                    </span>
                                }
                                else if ((int)o.Status >= 5 || o.Status.ToString().StartsWith("Return"))
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                        <i class="fa-solid fa-arrow-rotate-left me-1"></i>@o.Status
                                    </span>
                                }
                                else
                                {
                                    <!-- TEST 1 & TEST 2: Chỉ cho phép chuyển trạng thái theo luồng tiến hợp lệ -->
                                    <form method="post" asp-page-handler="UpdateStatus" class="d-inline">
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <select name="newStatus" class="form-select form-select-sm rounded-pill d-inline-block w-auto" onchange="this.form.submit()">
                                            <option value="@o.Status" selected>@o.Status (Hiện tại)</option>
                                            @if (o.Status == Models.Enums.OrderStatus.Pending)
                                            {
                                                <option value="@Models.Enums.OrderStatus.Processing">Chuẩn bị hàng (Processing)</option>
                                                <option value="@Models.Enums.OrderStatus.Cancelled">Hủy đơn (Cancelled)</option>
                                            }
                                            else if (o.Status == Models.Enums.OrderStatus.Processing)
                                            {
                                                <option value="@Models.Enums.OrderStatus.Shipping">Giao hàng (Shipping)</option>
                                                <option value="@Models.Enums.OrderStatus.Cancelled">Hủy đơn (Cancelled)</option>
                                            }
                                            else if (o.Status == Models.Enums.OrderStatus.Shipping)
                                            {
                                                <option value="@Models.Enums.OrderStatus.Delivered">Đã giao (Delivered)</option>
                                                <option value="@Models.Enums.OrderStatus.Cancelled">Hủy đơn (Cancelled)</option>
                                            }
                                        </select>
                                    </form>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="/Admin/Orders/Detail" asp-route-id="@o.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>