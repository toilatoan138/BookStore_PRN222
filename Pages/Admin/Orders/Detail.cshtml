@page "{id:int}"
@model BookStore.Pages.Admin.Orders.DetailModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.Order.Id}";
    ViewData["Subtitle"] = $"Khách hàng: {Model.Order.FullName} | Ngày đặt: {Model.Order.OrderDate.ToLocalTime():dd/MM/yyyy HH:mm}";
}

<div class="row g-4" style="max-width: 1000px;">
    <div class="col-lg-8">
        <!-- ORDER ITEMS -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-box-open text-danger me-2"></i>Danh sách sản phẩm trong đơn</h5>

            <div class="table-responsive">
                <table class="table align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Tạm tính</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Order.Details)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(item.Book.ImageUrl) ? "https://via.placeholder.com/40x55" : item.Book.ImageUrl)"
                                             alt="@item.Book.Title" class="rounded border" style="width: 40px; height: 55px; object-fit: cover;" />
                                        <div>
                                            <a asp-page="/Products/Detail" asp-route-id="@item.BookId" target="_blank" class="fw-bold text-dark text-decoration-none">
                                                @item.Book.Title
                                            </a>
                                            <div class="text-muted small">Mã vị trí kho: <strong>@(item.Book.LocationCode ?? "A-01-01")</strong></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">@item.Price.ToString("N0")đ</td>
                                <td class="text-center">x@item.Quantity</td>
                                <td class="text-end fw-bold text-danger">@((item.Quantity * item.Price).ToString("N0"))đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TOTALS -->
            <div class="row justify-content-end mt-3">
                <div class="col-md-6">
                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Phí vận chuyển:</span>
                        <span class="fw-semibold text-dark">@(Model.Order.ShippingFee == 0 ? "Miễn phí" : $"{Model.Order.ShippingFee:N0}đ")</span>
                    </div>
                    @if (Model.Order.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Giảm giá khuyến mãi / Voucher:</span>
                            <span class="fw-bold">-@Model.Order.DiscountAmount.ToString("N0")đ</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fw-bold fs-6">Tổng tiền:</span>
                        <span class="fs-4 fw-bold text-danger">@Model.Order.TotalAmount.ToString("N0")đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SHIPPING & CUSTOMER INFO -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-location-dot text-danger me-2"></i>Thông tin nhận hàng</h5>
            <div class="small text-secondary">
                <div class="mb-2"><strong>Người nhận:</strong> @Model.Order.FullName</div>
                <div class="mb-2"><strong>Số điện thoại:</strong> @Model.Order.PhoneNumber</div>
                <div class="mb-2"><strong>Địa chỉ giao:</strong> @Model.Order.ShippingAddress</div>
                <div class="mb-2"><strong>Hình thức thanh toán:</strong> @Model.Order.PaymentMethod</div>
            </div>
        </div>
    </div>

    <!-- RIGHT: STATUS CONTROLS -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-gear text-danger me-2"></i>Cập nhật trạng thái</h5>

            <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Order.Id">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Trạng thái hiện tại</label>
                    <select name="newStatus" class="form-select">
                        @foreach (Models.Enums.OrderStatus s in Enum.GetValues(typeof(Models.Enums.OrderStatus)))
                        {
                            <option value="@s" selected="@(Model.Order.Status == s)">@s</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Ghi chú trạng thái / mã vận đơn</label>
                    <textarea name="note" rows="3" class="form-control form-control-sm" placeholder="VD: Đã xuất kho giao bên vận chuyển ViettelPost...">@Model.Order.StatusNote</textarea>
                </div>

                <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Lưu trạng thái
                </button>
            </form>
        </div>

        <a asp-page="/Admin/Orders/Index" class="btn btn-outline-secondary w-100 rounded-pill">
            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách đơn
        </a>
    </div>
</div>
