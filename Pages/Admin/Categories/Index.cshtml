@page
@model BookStore.Pages.Admin.Categories.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="container-fluid px-0">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="border-start ps-3 border-3 border-info">
                <h4 class="fw-bold text-info m-0"><i class="fa-solid fa-folder-open me-2"></i>QUẢN LÝ DANH MỤC</h4>
                <small class="text-muted">Xem, thêm mới và quản lý các thể loại sách</small>
            </div>
        </div>
        <!-- NÚT MỞ CỬA SỔ MODAL THÊM MỚI -->
        <button type="button" class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createCatModal">
            <i class="fa-solid fa-plus me-1"></i> Thêm Danh Mục
        </button>
    </div>

    <!-- KHU VỰC THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BẢNG DỮ LIỆU -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <table class="table table-bordered table-hover align-middle w-100 mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width: 10%;">Mã</th>
                    <th style="width: 30%;" class="text-start">Tên Danh Mục</th>
                    <th style="width: 25%;">Danh Mục Cha</th>
                    <th style="width: 15%;">Số Sách</th>
                    <th style="width: 20%;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Categories.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">Không có danh mục nào. Hãy thêm mới!</td></tr>
                }
                else
                {
                    foreach (var item in Model.Categories)
                    {
                        <tr>
                            <td class="text-center fw-bold text-muted">#@item.Id</td>
                            <td>
                                <strong class="text-dark">@item.Name</strong>
                                <br><small class="text-muted">@item.Description</small>
                            </td>
                            <td class="text-center">
                                @if (item.Parent != null)
                                {
                                    <span class="badge bg-secondary">@item.Parent.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">-- Gốc --</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark rounded-pill px-3 py-1">@item.Books.Count sách</span>
                            </td>
                            <td class="text-center">
                                <!-- Nút Sửa mở Modal -->
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1"
                                        onclick="openEditModal(@item.Id, '@item.Name', '@(item.Description ?? "")', '@(item.ImageUrl ?? "")', @(item.ParentId ?? 0))">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <!-- Nút Xóa -->
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Cảnh báo: Bạn có chắc chắn muốn xóa danh mục này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ================= MODAL THÊM MỚI ================= -->
<div class="modal fade" id="createCatModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2"></i>Thêm Danh Mục Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        <input asp-for="Input.Name" class="form-control" placeholder="Ví dụ: Truyện Tranh..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục cha</label>
                        <select asp-for="Input.ParentId" class="form-select">
                            <option value="0">-- Là danh mục gốc --</option>
                            @foreach (var p in Model.Categories.Where(c => c.ParentId == null))
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả (Không bắt buộc)</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Nhập mô tả ngắn..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 rounded-bottom-4">
                    <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Lưu Danh Mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL CHỈNH SỬA ================= -->
<div class="modal fade" id="editCatModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh Sửa Danh Mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" id="editCatId" name="Input.Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        <input id="editCatName" name="Input.Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục cha</label>
                        <select id="editCatParent" name="Input.ParentId" class="form-select">
                            <option value="0">-- Là danh mục gốc --</option>
                            @foreach (var p in Model.Categories.Where(c => c.ParentId == null))
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả</label>
                        <textarea id="editCatDesc" name="Input.Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 rounded-bottom-4">
                    <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Kịch bản Javascript để bơm dữ liệu vào cửa sổ Sửa -->
<script>
    function openEditModal(id, name, desc, img, parentId) {
        document.getElementById('editCatId').value = id;
        document.getElementById('editCatName').value = name;
        document.getElementById('editCatDesc').value = desc;
        document.getElementById('editCatParent').value = parentId || 0;
        new bootstrap.Modal(document.getElementById('editCatModal')).show();
    }
</script>