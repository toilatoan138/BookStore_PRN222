@page
@model BookStore.Pages.Admin.Vouchers.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo Voucher Mới";
    ViewData["Subtitle"] = "Thiết lập mã khuyến mãi mới";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="max-width: 800px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Input.Code" class="form-label fw-semibold">Mã code voucher</label>
                <input asp-for="Input.Code" class="form-control text-uppercase fw-bold" placeholder="VD: MINDBOOK20" autofocus />
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.UsageLimit" class="form-label fw-semibold">Số lượt dùng tối đa</label>
                <input asp-for="Input.UsageLimit" type="number" class="form-control" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Input.DiscountPercent" class="form-label fw-semibold">Phần trăm giảm (%)</label>
                <input asp-for="Input.DiscountPercent" type="number" class="form-control" placeholder="VD: 15 (Nếu giảm theo %)" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.DiscountAmount" class="form-label fw-semibold">Số tiền giảm cố định (VNĐ)</label>
                <input asp-for="Input.DiscountAmount" type="number" step="1000" class="form-control" placeholder="VD: 50000 (Nếu giảm cố định)" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Input.MinOrderValue" class="form-label fw-semibold">Giá trị đơn hàng tối thiểu (VNĐ)</label>
                <input asp-for="Input.MinOrderValue" type="number" step="10000" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.MaxDiscount" class="form-label fw-semibold">Số tiền giảm tối đa (VNĐ)</label>
                <input asp-for="Input.MaxDiscount" type="number" step="10000" class="form-control" placeholder="Để trống nếu không giới hạn" />
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Input.StartDate" class="form-label fw-semibold">Ngày bắt đầu áp dụng</label>
                <input asp-for="Input.StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.EndDate" class="form-label fw-semibold">Ngày kết thúc hiệu lực</label>
                <input asp-for="Input.EndDate" type="date" class="form-control" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i>Tạo Voucher
            </button>
            <a asp-page="/Admin/Vouchers/Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                Hủy
            </a>
        </div>
    </form>
</div>
