@page
@model BookStore.Pages.Admin.Vouchers.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Mã Giảm Giá / Voucher";
    ViewData["Subtitle"] = "Thiết lập các chương trình khuyến mãi, mã giảm giá và đợt phát hành";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-ticket text-danger me-2"></i>Danh sách Voucher</h5>
        <a asp-page="/Admin/Vouchers/Create" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold shadow-sm">
            <i class="fa-solid fa-plus me-1"></i>Tạo Voucher mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle small">
            <thead class="table-light">
                <tr>
                    <th>Mã code</th>
                    <th>Mức giảm giá</th>
                    <th>Đơn tối thiểu</th>
                    <th>Giảm tối đa</th>
                    <th>Thời hạn hiệu lực</th>
                    <th>Lượt dùng</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Vouchers)
                {
                    bool isExpired = v.EndDate < DateTime.UtcNow;
                    <tr>
                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold fs-6">
                                @v.Code
                            </span>
                        </td>
                        <td class="fw-bold text-dark">
                            @(v.DiscountPercent > 0 ? $"{v.DiscountPercent}%" : $"{v.DiscountAmount:N0}đ")
                        </td>
                        <td>@v.MinOrderValue.ToString("N0")đ</td>
                        <td>@(v.MaxDiscount.HasValue ? $"{v.MaxDiscount.Value:N0}đ" : "Không giới hạn")</td>
                        <td>
                            <div>@v.StartDate.ToString("dd/MM/yyyy") - @v.EndDate.ToString("dd/MM/yyyy")</div>
                            @if (isExpired)
                            {
                                <small class="text-danger">Đã hết hạn</small>
                            }
                        </td>
                        <td>@v.UsageLimit</td>
                        <td>
                            @if (v.Status == 1 && !isExpired)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đang phát hành</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">Tạm dừng</span>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@v.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm @(v.Status == 1 ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3">
                                    @(v.Status == 1 ? "Tạm dừng" : "Kích hoạt")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
