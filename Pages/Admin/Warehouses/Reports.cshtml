@page
@model BookStore.Pages.Admin.Warehouses.ReportsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Báo Cáo Xuất - Nhập - Tồn (XNT)";
    ViewData["Subtitle"] = "Tổng hợp dòng luân chuyển hàng hóa, đối soát biến động kho và xuất báo cáo kế toán";
}

<!-- ACTION BAR -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div class="d-flex align-items-center gap-2">
        @if (Model.IsSuperAdmin)
        {
            <span class="badge bg-danger p-2 shadow-sm fs-6">
                <i class="fa-solid fa-crown text-warning me-1"></i>SUPER ADMIN
            </span>
        }
        else
        {
            <span class="badge bg-info text-dark p-2 shadow-sm fs-6">
                <i class="fa-solid fa-location-dot text-danger me-1"></i>@Model.UserBranchName
            </span>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-page-handler="ExportCsv" asp-route-branchId="@Model.BranchId" asp-route-fromDate="@Model.FromDate" asp-route-toDate="@Model.ToDate" class="btn btn-outline-success btn-sm fw-bold rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-file-csv me-1"></i> Tải Báo Cáo CSV (Excel)
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> In Báo Cáo
        </button>
    </div>
</div>

<!-- BỘ LỌC KỲ BÁO CÁO -->
<div class="card shadow-sm border-0 rounded-4 mb-4 bg-white">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Chi nhánh báo cáo</label>
                @if (Model.IsSuperAdmin)
                {
                    <select class="form-select" name="BranchId">
                        <option value="">-- Toàn bộ hệ thống (3 Miền) --</option>
                        @foreach (var br in Model.Branches)
                        {
                            <option value="@br.Id" selected="@(Model.BranchId == br.Id)">@br.Name (@br.City)</option>
                        }
                    </select>
                }
                else
                {
                    <input type="text" class="form-control bg-light fw-bold text-primary" value="@Model.UserBranchName" readonly />
                    <input type="hidden" name="BranchId" value="@Model.UserBranchId" />
                }
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Từ ngày</label>
                <input type="date" class="form-control" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Đến ngày</label>
                <input type="date" class="form-control" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Loại giao dịch</label>
                <select class="form-select" name="TransactionType">
                    <option value="">-- Tất cả loại GD --</option>
                    <option value="IMPORT" selected="@(Model.TransactionType == "IMPORT")">Nhập NCC (IMPORT)</option>
                    <option value="EXPORT" selected="@(Model.TransactionType == "EXPORT")">Xuất bán (EXPORT)</option>
                    <option value="TRANSFER_OUT" selected="@(Model.TransactionType == "TRANSFER_OUT")">Chuyển đi (TRANSFER_OUT)</option>
                    <option value="TRANSFER_IN" selected="@(Model.TransactionType == "TRANSFER_IN")">Nhận chuyển (TRANSFER_IN)</option>
                    <option value="ADJUSTMENT" selected="@(Model.TransactionType == "ADJUSTMENT")">Kiểm kê (ADJUSTMENT)</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill fw-bold rounded-pill px-3 shadow-sm">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Xem Báo Cáo
                </button>
                <a asp-page="/Admin/Warehouses/Reports" class="btn btn-outline-secondary btn-sm rounded-circle p-2 d-flex align-items-center justify-content-center" title="Đặt lại" style="width: 36px; height: 36px;">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 5 THẺ TỔNG HỢP KỲ BÁO CÁO -->
<div class="row g-3 mb-4 text-center">
    <div class="col-6 col-md-2">
        <div class="p-3 border-0 rounded-4 bg-white shadow-sm h-100">
            <div class="text-muted small fw-bold">Tổng Nhập (PO)</div>
            <div class="fs-4 fw-bold text-success mt-1">+@Model.TotalImportAll.ToString("N0")</div>
            <small class="text-muted">cuốn</small>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="p-3 border-0 rounded-4 bg-white shadow-sm h-100">
            <div class="text-muted small fw-bold">Tổng Xuất (Bán)</div>
            <div class="fs-4 fw-bold text-primary mt-1">-@Model.TotalExportAll.ToString("N0")</div>
            <small class="text-muted">cuốn</small>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="p-3 border-0 rounded-4 bg-white shadow-sm h-100">
            <div class="text-muted small fw-bold">Nhận Chuyển Kho</div>
            <div class="fs-4 fw-bold text-info mt-1">+@Model.TotalTransferInAll.ToString("N0")</div>
            <small class="text-muted">cuốn</small>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="p-3 border-0 rounded-4 bg-white shadow-sm h-100">
            <div class="text-muted small fw-bold">Xuất Chuyển Kho</div>
            <div class="fs-4 fw-bold text-warning mt-1">-@Model.TotalTransferOutAll.ToString("N0")</div>
            <small class="text-muted">cuốn</small>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="p-3 border-0 rounded-4 bg-white shadow-sm h-100">
            <div class="text-muted small fw-bold">Kiểm Kê Bù Trừ</div>
            <div class="fs-4 fw-bold @(Model.TotalAdjustmentAll >= 0 ? "text-success" : "text-danger") mt-1">
                @(Model.TotalAdjustmentAll > 0 ? "+" + Model.TotalAdjustmentAll.ToString("N0") : Model.TotalAdjustmentAll.ToString("N0"))
            </div>
            <small class="text-muted">cuốn</small>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="p-3 border-0 rounded-4 bg-primary bg-opacity-10 shadow-sm h-100 border border-primary border-opacity-25">
            <div class="text-primary small fw-bold">Tồn Kho Hiện Tại</div>
            <div class="fs-4 fw-bold text-primary mt-1">@Model.TotalCurrentStockAll.ToString("N0")</div>
            <small class="text-muted">cuốn</small>
        </div>
    </div>
</div>

<!-- TABS DỮ LIỆU -->
<div class="card shadow-sm border-0 rounded-4 bg-white">
    <div class="card-header bg-white py-3 border-0 border-bottom">
        <ul class="nav nav-pills card-header-pills" id="reportTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold rounded-pill px-3" id="matrix-tab" data-bs-toggle="tab" data-bs-target="#matrixTabPane" type="button" role="tab">
                    <i class="fa-solid fa-table-list me-1"></i> Tổng Hợp XNT Theo Đầu Sách (@Model.ReportItems.Count)
                </button>
            </li>
            <li class="nav-item ms-2" role="presentation">
                <button class="nav-link fw-bold rounded-pill px-3" id="log-tab" data-bs-toggle="tab" data-bs-target="#logTabPane" type="button" role="tab">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Nhật Ký Biến Động Chi Tiết (@Model.HistoryList.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="reportTabsContent">
            <!-- TAB 1: BẢNG TỔNG HỢP THEO ĐẦU SÁCH -->
            <div class="tab-pane fade show active" id="matrixTabPane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Tên Sách</th>
                                <th>Danh Mục</th>
                                <th class="text-center text-success">Nhập NCC (+)</th>
                                <th class="text-center text-primary">Xuất Bán (-)</th>
                                <th class="text-center text-info">Nhận Chuyển (+)</th>
                                <th class="text-center text-warning">Xuất Chuyển (-)</th>
                                <th class="text-center">Kiểm Kê (+/-)</th>
                                <th class="text-center fw-bold bg-primary bg-opacity-10 text-primary pe-4">Tồn Kho Hiện Tại</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ReportItems.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-5">Không có dữ liệu báo cáo nào.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.ReportItems)
                                {
                                    <tr>
                                        <td class="text-muted small ps-4">#@item.BookId</td>
                                        <td class="fw-bold text-dark">@item.Title</td>
                                        <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                                        <td class="text-center fw-bold text-success">@(item.TotalImport > 0 ? "+" + item.TotalImport : "0")</td>
                                        <td class="text-center fw-bold text-primary">@(item.TotalExport > 0 ? "-" + item.TotalExport : "0")</td>
                                        <td class="text-center fw-bold text-info">@(item.TotalTransferIn > 0 ? "+" + item.TotalTransferIn : "0")</td>
                                        <td class="text-center fw-bold text-warning">@(item.TotalTransferOut > 0 ? "-" + item.TotalTransferOut : "0")</td>
                                        <td class="text-center fw-bold @(item.TotalAdjustment >= 0 ? "text-success" : "text-danger")">
                                            @(item.TotalAdjustment > 0 ? "+" + item.TotalAdjustment : item.TotalAdjustment.ToString())
                                        </td>
                                        <td class="text-center bg-primary bg-opacity-10 pe-4">
                                            <span class="badge @(item.CurrentStock == 0 ? "bg-danger" : (item.CurrentStock <= 5 ? "bg-warning text-dark" : "bg-primary")) fs-6 fw-bold rounded-pill px-3">
                                                @item.CurrentStock.ToString("N0")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 2: NHẬT KÝ BIẾN ĐỘNG CHI TIẾT -->
            <div class="tab-pane fade" id="logTabPane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Thời Gian</th>
                                <th>Sách</th>
                                <th>Loại Giao Dịch</th>
                                <th class="text-center">Biến Động</th>
                                <th>Mã Liên Quan</th>
                                <th class="pe-4">Người Thực Hiện</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.HistoryList.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">Chưa có giao dịch biến động nào phù hợp.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var h in Model.HistoryList)
                                {
                                    <tr>
                                        <td class="ps-4">@h.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>
                                            <span class="fw-bold text-dark">@h.Book?.Title</span>
                                            <small class="text-muted d-block">ID: #@h.BookId</small>
                                        </td>
                                        <td>
                                            @switch (h.TransactionType?.ToUpper())
                                            {
                                                case "IMPORT":
                                                    <span class="badge bg-success">Nhập NCC (IMPORT)</span>
                                                    break;
                                                case "EXPORT":
                                                    <span class="badge bg-primary">Xuất bán (EXPORT)</span>
                                                    break;
                                                case "TRANSFER_OUT":
                                                    <span class="badge bg-warning text-dark">Chuyển đi (TRANSFER_OUT)</span>
                                                    break;
                                                case "TRANSFER_IN":
                                                    <span class="badge bg-info text-dark">Nhận chuyển (TRANSFER_IN)</span>
                                                    break;
                                                case "ADJUSTMENT":
                                                    <span class="badge bg-secondary">Kiểm kê (ADJUSTMENT)</span>
                                                    break;
                                                case "RETURN":
                                                    <span class="badge bg-info text-white">Khách trả (RETURN)</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-dark">@h.TransactionType</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-center fw-bold fs-6 @(h.QuantityChanged >= 0 ? "text-success" : "text-danger")">
                                            @(h.QuantityChanged > 0 ? "+" + h.QuantityChanged : h.QuantityChanged.ToString())
                                        </td>
                                        <td>
                                            <span class="text-muted">@(h.RelatedId.HasValue ? $"#{h.RelatedId.Value}" : "-")</span>
                                        </td>
                                        <td class="pe-4">
                                            <div>@(h.CreatedBy?.FullName ?? h.CreatedBy?.UserName ?? "Hệ thống")</div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
