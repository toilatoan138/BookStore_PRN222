@page
@model BookStore.Pages.Staff.Tickets.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Khiếu Nại & Yêu Cầu Đổi Trả";
    ViewData["Subtitle"] = "Tiếp nhận ticket hỗ trợ kỹ thuật và xét duyệt các yêu cầu trả hàng từ khách hàng";
}

<div class="container-fluid px-0">

    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-page="/Staff/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
                <i class="fa-solid fa-chart-line me-1"></i> Dashboard
            </a>
            <div class="border-start ps-3">
                <h4 class="fw-bold text-danger m-0">
                    <i class="fa-solid fa-headset me-2"></i>
                    QUẢN LÝ KHIẾU NẠI & HỖ TRỢ
                </h4>
                <small class="text-muted">Xử lý ticket hỗ trợ và xét duyệt đơn trả hàng</small>
            </div>
        </div>

        <a asp-page="/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-store me-1"></i> Về Cửa hàng
        </a>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-4" id="staffTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.Tab != "return" ? "active" : "") fw-bold text-danger" id="ticket-tab" data-bs-toggle="tab" data-bs-target="#ticket-pane" type="button" role="tab">
                <i class="fa-solid fa-comments me-2"></i> Quản lý Khiếu nại (@Model.Tickets.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.Tab == "return" ? "active" : "") fw-bold text-warning" id="return-tab" data-bs-toggle="tab" data-bs-target="#return-pane" type="button" role="tab">
                <i class="fa-solid fa-box-open me-2"></i> Duyệt Yêu cầu Trả hàng (@Model.ReturnRequests.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="staffTabContent">

        <!-- ======================= TAB 1: SUPPORT TICKETS ======================= -->
        <div class="tab-pane fade @(Model.Tab != "return" ? "show active" : "")" id="ticket-pane" role="tabpanel">
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle w-100 mb-0">
                        <thead class="table-light">
                            <tr class="text-uppercase text-muted" style="font-size: 13px;">
                                <th class="text-center" style="width: 10%;">Mã Ticket</th>
                                <th style="width: 20%;">Khách Hàng</th>
                                <th style="width: 15%;">Loại Vấn Đề</th>
                                <th style="width: 25%;">Tiêu Đề</th>
                                <th class="text-center" style="width: 15%;">Ngày Tạo</th>
                                <th class="text-center" style="width: 10%;">Trạng Thái</th>
                                <th class="text-center" style="width: 10%;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Tickets.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chưa có ticket khiếu nại nào từ khách hàng.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var t in Model.Tickets)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">
                                            <span class="badge bg-light text-secondary border font-monospace px-2 py-1">
                                                TK-@t.TicketId.ToString("D5")
                                            </span>
                                        </td>
                                        <td>
                                            <strong class="text-dark d-block">@(t.User?.FullName ?? "Khách hàng")</strong>
                                            <small class="text-muted">@(t.User?.Email ?? "")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                @(t.IssueType ?? "Hỗ trợ chung")
                                            </span>
                                        </td>
                                        <td>
                                            <strong class="text-dark d-block text-truncate" style="max-width: 250px;" title="@t.TicketSubject">
                                                @t.TicketSubject
                                            </strong>
                                            <small class="text-muted d-block text-truncate" style="max-width: 250px;">
                                                @t.TicketMessage
                                            </small>
                                        </td>
                                        <td class="text-center small text-muted">@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">
                                            @switch (t.Status)
                                            {
                                                case "Pending":
                                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="fa-solid fa-hourglass-half me-1"></i>Chờ xử lý</span>
                                                    break;
                                                case "Replied":
                                                    <span class="badge bg-success px-2 py-1"><i class="fa-solid fa-check-double me-1"></i>Đã phản hồi</span>
                                                    break;
                                                case "Closed":
                                                    <span class="badge bg-secondary px-2 py-1"><i class="fa-solid fa-lock me-1"></i>Đã đóng</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark border px-2 py-1">@t.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-center text-nowrap">
                                            <!-- VÁ XSS: Sử dụng data attributes thay vì gọi hàm onclick chứa dữ liệu trực tiếp -->
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold btn-reply-ticket"
                                                    data-id="@t.TicketId"
                                                    data-customer="@(t.User?.FullName ?? "Khách hàng")"
                                                    data-issue="@(t.IssueType ?? "Hỗ trợ chung")"
                                                    data-subject="@t.TicketSubject"
                                                    data-message="@t.TicketMessage"
                                                    data-reply="@(t.AdminReply ?? "")"
                                                    data-status="@t.Status">
                                                <i class="fa-solid fa-reply me-1"></i>Phản hồi
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ======================= TAB 2: DUYỆT YÊU CẦU TRẢ HÀNG ======================= -->
        <div class="tab-pane fade @(Model.Tab == "return" ? "show active" : "")" id="return-pane" role="tabpanel">
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle w-100 mb-0">
                        <thead class="table-light">
                            <tr class="text-uppercase text-muted" style="font-size: 13px;">
                                <th class="text-center" style="width: 8%;">Mã Đơn</th>
                                <th style="width: 20%;">Khách Hàng</th>
                                <th style="width: 22%;">Sách & Số Lượng</th>
                                <th style="width: 20%;">Lý Do Trả</th>
                                <th class="text-center" style="width: 15%;">Ngày Yêu Cầu</th>
                                <th class="text-center" style="width: 10%;">Trạng Thái</th>
                                <th class="text-center" style="width: 15%;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ReturnRequests.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chưa có yêu cầu trả hàng nào từ khách hàng.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var r in Model.ReturnRequests)
                                {
                                    <tr>
                                        <td class="text-center fw-bold font-monospace text-primary">#ORD-@r.OrderId</td>
                                        <td>
                                            <strong class="text-dark d-block">@(r.Order?.FullName ?? r.Order?.User?.FullName ?? "Khách hàng")</strong>
                                            <small class="text-muted"><i class="fa-solid fa-phone me-1"></i>@(r.Order?.PhoneNumber ?? "N/A")</small>
                                        </td>
                                        <td>
                                            <strong class="text-dark d-block">@(r.Book?.Title ?? "Sách #" + r.BookId)</strong>
                                            <small class="text-danger fw-bold">Số lượng: @r.Quantity quyển</small>
                                        </td>
                                        <!-- VÁ GIAO DIỆN: Thêm text-break để chống tràn bảng khi khách hàng spam ký tự -->
                                        <td class="small fst-italic text-muted text-break" style="max-width: 250px;">
                                            @r.CustomerReason
                                        </td>
                                        <td class="text-center small text-muted">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">
                                            @switch (r.Status)
                                            {
                                                case 0:
                                                    <span class="badge bg-warning text-dark px-2 py-1">Chờ duyệt</span>
                                                    break;
                                                case 1:
                                                    <span class="badge bg-info text-dark px-2 py-1">Đã duyệt (Chờ QC)</span>
                                                    break;
                                                case 2:
                                                    <span class="badge bg-danger px-2 py-1">Đã từ chối</span>
                                                    break;
                                                case 3:
                                                    <span class="badge bg-success px-2 py-1">Đã nhập kho</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary px-2 py-1">Khác</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-center text-nowrap">
                                            @if (r.Status == 0)
                                            {
                                                <div class="d-flex justify-content-center gap-1">
                                                    <form method="post" asp-page-handler="ApproveReturn" asp-route-returnId="@r.ReturnId" class="d-inline"
                                                          onsubmit="return confirm('Xác nhận duyệt yêu cầu trả hàng này? Đơn sẽ được chuyển sang Kho để kiểm hàng QC.');">
                                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-2 fw-semibold" title="Duyệt">
                                                            <i class="fa-solid fa-check me-1"></i>Duyệt
                                                        </button>
                                                    </form>
                                                    <form method="post" asp-page-handler="RejectReturn" asp-route-returnId="@r.ReturnId" class="d-inline"
                                                          onsubmit="return confirm('Bạn có chắc muốn từ chối yêu cầu trả hàng này?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Từ chối">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Đã xử lý</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PHẢN HỒI SUPPORT TICKET -->
<div class="modal fade" id="replyTicketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-headset me-2"></i>Phản Hồi Khiếu Nại & Hỗ Trợ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="ReplyTicket">
                <div class="modal-body p-4">
                    <input type="hidden" name="ticketId" id="modalTicketId" />

                    <div class="mb-3 bg-light p-3 rounded-3 border">
                        <div class="d-flex justify-content-between mb-2">
                            <div>Khách hàng: <strong id="modalTicketCustomer" class="text-dark"></strong></div>
                            <span class="badge bg-info text-dark" id="modalTicketIssue"></span>
                        </div>
                        <div class="fw-bold text-dark fs-6 mb-1 text-break" id="modalTicketSubject"></div>
                        <p class="text-muted small mb-0 text-break" id="modalTicketMessage"></p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Nội dung phản hồi CSKH <span class="text-danger">*</span></label>
                        <!-- VÁ BẢO MẬT & UI/UX: Thêm maxlength="500" chống tràn db, thêm hiển thị bộ đếm ký tự -->
                        <textarea name="adminReply" id="modalAdminReply" class="form-control" rows="4" maxlength="500" placeholder="Chào bạn, về vấn đề này MindBook Store xin phản hồi..." required></textarea>
                        <div class="text-end small text-muted mt-1"><span id="charCount">0</span>/500 ký tự</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Cập nhật trạng thái Ticket</label>
                        <select name="newStatus" id="modalTicketStatus" class="form-select">
                            <option value="Replied">Replied (Đã phản hồi)</option>
                            <option value="Closed">Closed (Đã giải quyết & Đóng ticket)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Gửi Phản Hồi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Xử lý đếm ký tự
        const replyTextarea = document.getElementById('modalAdminReply');
        const charCount = document.getElementById('charCount');
        replyTextarea.addEventListener('input', function() {
            charCount.textContent = this.value.length;
        });

        // VÁ XSS (CROSS-SITE SCRIPTING): Nhận dữ liệu an toàn qua Dataset và dùng textContent
        document.querySelectorAll('.btn-reply-ticket').forEach(button => {
            button.addEventListener('click', function() {
                document.getElementById('modalTicketId').value = this.dataset.id;
                document.getElementById('modalTicketCustomer').textContent = this.dataset.customer;
                document.getElementById('modalTicketIssue').textContent = this.dataset.issue;
                document.getElementById('modalTicketSubject').textContent = this.dataset.subject;
                document.getElementById('modalTicketMessage').textContent = this.dataset.message;

                replyTextarea.value = this.dataset.reply;
                charCount.textContent = this.dataset.reply.length;

                if (this.dataset.status === "Closed") {
                    document.getElementById('modalTicketStatus').value = "Closed";
                } else {
                    document.getElementById('modalTicketStatus').value = "Replied";
                }

                new bootstrap.Modal(document.getElementById('replyTicketModal')).show();
            });
        });
    </script>
}