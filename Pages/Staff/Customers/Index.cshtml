@page
@model BookStore.Pages.Staff.Customers.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Khách Hàng & VIP CRM";
    ViewData["Subtitle"] = "Theo dõi, phân khúc khách hàng theo hạng thẻ và chăm sóc cá nhân hóa";
}

<div class="container-fluid px-0">
    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-page="/Staff/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
                <i class="fa-solid fa-chart-line me-1"></i> Dashboard
            </a>
            <div class="border-start ps-3">
                <h4 class="fw-bold m-0 text-danger">
                    <i class="fa-solid fa-users-viewfinder me-2"></i>
                    QUẢN LÝ KHÁCH HÀNG
                </h4>
                <small class="text-muted">Theo dõi và chăm sóc trải nghiệm của khách hàng</small>
            </div>
        </div>

        <a asp-page="/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-store me-1"></i> Về Cửa hàng
        </a>
    </div>

    <!-- BỘ LỌC KHÁCH HÀNG VIP -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h6 class="fw-bold text-danger mb-3"><i class="fa-solid fa-filter me-2"></i>Bộ lọc Khách hàng VIP:</h6>
        <form method="get" id="filterForm" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Hạng thành viên</label>
                <select name="tier" class="form-select">
                    <option value="">-- Tất cả hạng --</option>
                    <option value="Đồng" selected="@(Model.Tier == "Đồng")">🥉 Đồng</option>
                    <option value="Bạc" selected="@(Model.Tier == "Bạc")">🥈 Bạc</option>
                    <option value="Vàng" selected="@(Model.Tier == "Vàng")">🥇 Vàng</option>
                    <option value="Kim Cương" selected="@(Model.Tier == "Kim Cương")">💎 Kim Cương</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">F-Point (Từ):</label>
                <input type="number" name="fromPoints" id="fromPointsInput" class="form-control" min="0" placeholder="VD: 500" value="@Model.FromPoints" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">F-Point (Đến):</label>
                <input type="number" name="toPoints" id="toPointsInput" class="form-control" min="0" placeholder="VD: 5000" value="@Model.ToPoints" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Tìm kiếm</label>
                <input type="text" name="keyword" class="form-control" placeholder="Nhập ID, Tên, Email, SĐT..." value="@Model.Keyword" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4 fw-bold w-100">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Mặc định</a>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle w-100 mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Khách Hàng</th>
                        <th class="text-center" style="width: 140px;">Ngày Tham Gia</th>
                        <th class="text-center" style="width: 150px;">Hạng & F-Point</th>
                        <th class="text-center" style="width: 150px;">Tổng Chi Tiêu</th>
                        <th>Nhãn CRM & Ghi Chú</th>
                        <th class="text-center" style="width: 160px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Customers.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fa-solid fa-user-slash fa-2x mb-2 d-block text-secondary"></i>
                                Không tìm thấy khách hàng nào phù hợp bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center fw-bold border text-secondary" style="width: 38px; height: 38px; min-width: 38px;">
                                            @(string.IsNullOrEmpty(c.FullName) ? "K" : c.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(c.FullName) ? "Khách hàng" : c.FullName)</div>
                                            <div class="small text-muted">@c.Email</div>
                                            <small class="text-muted d-block">
                                                <i class="fa-solid fa-phone me-1"></i>@(string.IsNullOrEmpty(c.PhoneNumber) ? "Chưa có SĐT" : c.PhoneNumber)
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center text-muted">@c.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge @(c.MembershipTier == "Kim Cương" ? "bg-info text-dark" : c.MembershipTier == "Vàng" ? "bg-warning text-dark" : c.MembershipTier == "Bạc" ? "bg-secondary text-white" : "bg-light text-dark border") px-2 py-1 mb-1">
                                        <i class="fa-solid fa-medal me-1"></i>@c.MembershipTier
                                    </span>
                                    <div class="fw-bold text-warning small">
                                        <i class="fa-solid fa-coins me-1"></i>@c.FPoints pts
                                    </div>
                                </td>
                                <td class="text-center fw-bold @(c.TotalSpent > 0 ? "text-danger" : "text-muted")">
                                    @c.TotalSpent.ToString("N0")đ
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.CrmTags))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@c.CrmTags</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <a asp-page="/Staff/Customers/Detail" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger rounded-pill px-2 me-1" title="Hồ sơ">
                                        <i class="fa-solid fa-id-card me-1"></i>Hồ sơ
                                    </a>
                                    <a asp-page="/Staff/Chat" asp-route-userId="@c.Id" class="btn btn-sm btn-outline-success rounded-circle" title="Nhắn tin với khách">
                                        <i class="fa-solid fa-comment-dots"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('filterForm').addEventListener('submit', function(e) {
            const fromVal = document.getElementById('fromPointsInput').value;
            const toVal = document.getElementById('toPointsInput').value;

            if (fromVal !== '' && parseInt(fromVal) < 0) {
                alert('Điểm F-Point bắt đầu không được là số âm!');
                e.preventDefault();
                return;
            }

            if (toVal !== '' && parseInt(toVal) < 0) {
                alert('Điểm F-Point kết thúc không được là số âm!');
                e.preventDefault();
                return;
            }

            if (fromVal !== '' && toVal !== '' && parseInt(fromVal) > parseInt(toVal)) {
                alert('Điểm F-Point bắt đầu phải nhỏ hơn hoặc bằng điểm kết thúc!');
                e.preventDefault();
                return;
            }
        });
    </script>
}