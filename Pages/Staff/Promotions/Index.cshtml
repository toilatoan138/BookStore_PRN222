@page
@model BookStore.Pages.Staff.Promotions.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Khuyến Mãi - Staff Dashboard";
    ViewData["Subtitle"] = "Thiết lập các đợt Flash Sale và chọn các sách áp dụng khuyến mãi";
}

<div class="container-fluid px-0">
    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-page="/Staff/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
                <i class="fa-solid fa-house me-1"></i> Trang chủ Staff
            </a>
            <h4 class="fw-bold text-danger m-0">
                <i class="fa-solid fa-bolt me-2"></i> QUẢN LÝ FLASH SALE
            </h4>
        </div>

        <button type="button" class="btn btn-danger btn-sm shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#createPromoModal">
            <i class="fa-solid fa-plus me-1"></i> Tạo Đợt Sale Mới
        </button>
    </div>

    <!-- TABLE -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle w-100 mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 8%;">ID</th>
                        <th style="width: 25%;">Tên Chương Trình</th>
                        <th class="text-center" style="width: 12%;">Giảm Giá</th>
                        <th class="text-center" style="width: 18%;">Thời Gian Bắt Đầu</th>
                        <th class="text-center" style="width: 18%;">Thời Gian Kết Thúc</th>
                        <th class="text-center" style="width: 12%;">Trạng Thái</th>
                        <th class="text-center" style="width: 15%;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Promotions.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có chương trình khuyến mãi nào!</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model.Promotions)
                        {
                            <tr>
                                <td class="text-center fw-bold">#@p.PromoId</td>
                                <td class="fw-bold text-primary">@p.PromoName</td>
                                <td class="text-center">
                                    <span class="badge bg-danger fs-6 px-3 py-1">-@p.DiscountPercent%</span>
                                </td>
                                <td class="text-center small">@p.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center small">@p.EndDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    @if (p.IsActive && p.EndDate >= DateTime.UtcNow)
                                    {
                                        <span class="badge bg-success px-2 py-1">Đang kích hoạt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Đã tắt / Hết hạn</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-page="/Staff/Promotions/Books" asp-route-id="@p.PromoId" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Quản lý sách trong đợt sale">
                                            <i class="fa-solid fa-book-open me-1"></i> Sách (@(p.PromotionBooks?.Count ?? 0))
                                        </a>

                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-2" title="Sửa"
                                                onclick="openEditPromoModal(@p.PromoId, '@Html.Raw(Html.Encode(p.PromoName))', @p.DiscountPercent, '@p.StartDate.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")', '@p.EndDate.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")', @(p.IsActive ? "true" : "false"))">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>

                                        <form method="post" asp-page-handler="Toggle" asp-route-id="@p.PromoId" class="d-inline">
                                            <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-secondary" : "btn-outline-success") rounded-pill px-2" title="Bật/Tắt">
                                                <i class="fa-solid @(p.IsActive ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================= MODAL TẠO PROMOTION ======================= -->
<div class="modal fade" id="createPromoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-bolt me-2"></i>Tạo Đợt Flash Sale Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create" id="createPromoForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tên đợt Sale / Chương trình *</label>
                        <input type="text" name="name" class="form-control" placeholder="VD: Flash Sale Cuối Tuần 30%" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Mức giảm giá (%) *</label>
                        <input type="number" name="discountPercent" id="createDiscount" class="form-control fw-bold text-danger fs-5" min="1" max="100" value="20" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Bắt đầu *</label>
                            <input type="datetime-local" name="startDate" id="createStart" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Kết thúc *</label>
                            <input type="datetime-local" name="endDate" id="createEnd" class="form-control" value="@DateTime.Now.AddDays(3).ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="createIsActive" checked />
                        <label class="form-check-label fw-semibold" for="createIsActive">Kích hoạt ngay khi lưu</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Tạo Chương Trình</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================= MODAL SỬA PROMOTION ======================= -->
<div class="modal fade" id="editPromoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh Sửa Flash Sale</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit" id="editPromoForm">
                <div class="modal-body p-4">
                    <input type="hidden" name="promoId" id="editPromoId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tên đợt Sale *</label>
                        <input type="text" name="name" id="editPromoName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Mức giảm giá (%) *</label>
                        <input type="number" name="discountPercent" id="editPromoDiscount" class="form-control fw-bold text-danger fs-5" min="1" max="100" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Bắt đầu *</label>
                            <input type="datetime-local" name="startDate" id="editPromoStart" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Kết thúc *</label>
                            <input type="datetime-local" name="endDate" id="editPromoEnd" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="editPromoActive" />
                        <label class="form-check-label fw-semibold" for="editPromoActive">Trạng thái kích hoạt</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark">Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditPromoModal(id, name, discount, start, end, active) {
            document.getElementById('editPromoId').value = id;
            document.getElementById('editPromoName').value = name;
            document.getElementById('editPromoDiscount').value = discount;
            document.getElementById('editPromoStart').value = start;
            document.getElementById('editPromoEnd').value = end;
            document.getElementById('editPromoActive').checked = active;
            new bootstrap.Modal(document.getElementById('editPromoModal')).show();
        }

        // Logic chống nghịch lý thời gian
        function validatePromoForm(prefix) {
            const startVal = document.getElementById(prefix + 'Start').value;
            const endVal = document.getElementById(prefix + 'End').value;
            const discount = parseInt(document.getElementById(prefix + 'Discount').value);

            if (discount <= 0 || discount > 100) {
                alert("Mức giảm giá phải nằm trong khoảng từ 1% đến 100%!");
                return false;
            }

            if (startVal && endVal) {
                const startDate = new Date(startVal);
                const endDate = new Date(endVal);
                if (startDate >= endDate) {
                    alert("Thời gian bắt đầu phải sớm hơn thời gian kết thúc!");
                    return false;
                }
            }
            return true;
        }

        document.getElementById('createPromoForm').addEventListener('submit', function(e) {
            if (!validatePromoForm('create')) e.preventDefault();
        });

        document.getElementById('editPromoForm').addEventListener('submit', function(e) {
            if (!validatePromoForm('edit')) e.preventDefault();
        });
    </script>
}