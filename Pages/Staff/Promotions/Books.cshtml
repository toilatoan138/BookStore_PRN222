@page
@model BookStore.Pages.Staff.Promotions.BooksModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Sách Khuyến Mãi (Promo Books)";
    ViewData["Subtitle"] = "Thêm và bớt các đầu sách tham gia đợt giảm giá Flash Sale";
}

<div class="container-fluid px-0">

    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3 small" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-page="/Staff/Promotions/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Danh sách Flash Sale
        </a>

        <h4 class="fw-bold text-danger m-0 text-center">
            <i class="fa-solid fa-book-open me-2"></i>
            SÁCH TRONG ĐỢT FLASH SALE
        </h4>

        @if (Model.PromotionInfo != null && Model.PromotionInfo.IsActive && Model.PromotionInfo.EndDate >= DateTime.UtcNow)
        {
            <button type="button" class="btn btn-danger btn-sm shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addBookModal">
                <i class="fa-solid fa-plus me-1"></i> Thêm Sách Vào Sale
            </button>
        }
        else
        {
            <button type="button" class="btn btn-secondary btn-sm shadow-sm fw-bold" disabled title="Chương trình này đã khóa hoặc hết hạn">
                <i class="fa-solid fa-lock me-1"></i> Sale Đã Đóng
            </button>
        }
    </div>

    @if (Model.PromotionInfo != null)
    {
        <!-- PROMO INFO BANNER -->
        <div class="bg-white p-4 rounded-4 shadow-sm mb-4 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        @Model.PromotionInfo.PromoName
                        <span class="badge bg-danger fs-6 ms-2">-@Model.PromotionInfo.DiscountPercent% OFF</span>
                    </h5>
                    <small class="text-muted">
                        Thời gian: <strong>@Model.PromotionInfo.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong> đến <strong>@Model.PromotionInfo.EndDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </small>
                </div>
                <div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2 fw-bold">
                        @(Model.PromotionInfo.PromotionBooks?.Count ?? 0) đầu sách tham gia
                    </span>
                </div>
            </div>
        </div>

        <!-- TABLE OF PROMO BOOKS -->
        <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle w-100 mb-0">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th style="width: 5%;">STT</th>
                            <th style="width: 8%;">Ảnh</th>
                            <th style="width: 35%;" class="text-start">Tên Sách</th>
                            <th style="width: 15%;">Thể Loại</th>
                            <th style="width: 12%;">Giá Gốc</th>
                            <th style="width: 15%;">Giá Sau Giảm (-@Model.PromotionInfo.DiscountPercent%)</th>
                            <th style="width: 10%;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PromotionInfo.PromotionBooks == null || !Model.PromotionInfo.PromotionBooks.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Đợt sale này hiện chưa có sách nào. Hãy bấm "Thêm Sách Vào Sale" để thêm sản phẩm!
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 0;
                            foreach (var pb in Model.PromotionInfo.PromotionBooks)
                            {
                                index++;
                                decimal rawDiscountedPrice = (pb.Book?.Price ?? 0) * (100 - Model.PromotionInfo.DiscountPercent) / 100m;
                                // Test 4: Làm tròn giá tiền tránh số lẻ thập phân
                                long cleanDiscountedPrice = (long)Math.Round(rawDiscountedPrice);

                                <tr>
                                    <td class="text-center fw-bold text-muted">@index</td>
                                    <td class="text-center">
                                        <img src="@(string.IsNullOrEmpty(pb.Book?.ImageUrl) ? "https://placehold.co/45x65?text=Img" : pb.Book.ImageUrl)"
                                             alt="@(pb.Book?.Title ?? "Sách")"
                                             style="width: 45px; height: 65px; object-fit: cover;"
                                             class="rounded border"
                                             onerror="this.src='https://placehold.co/45x65?text=Img'" />
                                    </td>
                                    <td class="text-start fw-bold text-dark">
                                        @(pb.Book?.Title ?? "Sách #" + pb.BookId)
                                        <div class="small text-muted fw-normal">Tác giả: @(pb.Book?.Author ?? "N/A")</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@(pb.Book?.Category?.Name ?? "Chung")</span>
                                    </td>
                                    <td class="text-center text-decoration-line-through text-muted">
                                        @((pb.Book?.Price ?? 0).ToString("N0"))đ
                                    </td>
                                    <td class="text-center fw-bold text-danger fs-6">
                                        @cleanDiscountedPrice.ToString("N0")đ
                                    </td>
                                    <td class="text-center">
                                        <form method="post" asp-page-handler="RemoveBook" asp-route-promoId="@Model.PromotionInfo.PromoId" asp-route-bookId="@pb.BookId"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa sách này khỏi đợt khuyến mãi?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                                                <i class="fa-solid fa-trash me-1"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- MODAL THÊM SÁCH VÀO SALE -->
<div class="modal fade" id="addBookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2"></i>Thêm Sách Vào Đợt Flash Sale</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Ảnh & Tên Sách</th>
                                <th>Giá Gốc</th>
                                <th>Tồn Kho</th>
                                <th class="text-center">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.AvailableBooks.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">Tất cả sách đang hoạt động đã được thêm vào đợt sale này.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var b in Model.AvailableBooks)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@(string.IsNullOrEmpty(b.ImageUrl) ? "https://placehold.co/35x50?text=Img" : b.ImageUrl)"
                                                     alt="@b.Title" style="width: 35px; height: 50px; object-fit: cover;" class="rounded border" />
                                                <div>
                                                    <strong class="text-dark d-block">@b.Title</strong>
                                                    <small class="text-muted">@(b.Category?.Name ?? "Chung")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-dark">@b.Price.ToString("N0")đ</td>
                                        <td>
                                            @if (b.StockQuantity > 0)
                                            {
                                                <span class="badge bg-secondary">@b.StockQuantity</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Hết hàng</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (b.StockQuantity > 0)
                                            {
                                                <form method="post" asp-page-handler="AddBook" asp-route-promoId="@Model.Id" asp-route-bookId="@b.Id">
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">
                                                        <i class="fa-solid fa-plus me-1"></i> Thêm
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <!-- Test 5: Không cho phép thêm sách hết tồn kho -->
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold" disabled title="Không thể thêm sách đang hết hàng">
                                                    Hết hàng
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>