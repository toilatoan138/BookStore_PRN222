@page "{id:int}"
@model BookStore.Pages.Products.DetailModel
@{
    ViewData["Title"] = Model.Book.Title;
}

<div class="container py-4">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-page="/Index" class="text-danger text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-page="/Search" asp-route-categoryId="@Model.Book.CategoryId" class="text-danger text-decoration-none">@Model.Book.Category?.Name</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@Model.Book.Title</li>
        </ol>
    </nav>

    <!-- ======================== MAIN PRODUCT SECTION ======================== -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="row g-4">
            <!-- IMAGE GALLERY -->
            <div class="col-md-5 col-lg-4">
                <div class="border rounded-3 p-2 text-center bg-light mb-3">
                    <img id="mainBookImg"
                         src="@(string.IsNullOrEmpty(Model.Book.ImageUrl) ? "https://via.placeholder.com/350x480?text=MindBook" : Model.Book.ImageUrl)"
                         alt="@Model.Book.Title"
                         class="img-fluid rounded"
                         style="max-height: 400px; object-fit: contain;" />
                </div>
                @if (Model.Book.DetailImages.Any())
                {
                    <div class="d-flex gap-2 overflow-auto py-1">
                        <img src="@Model.Book.ImageUrl"
                             class="border rounded p-1"
                             style="width: 60px; height: 80px; object-fit: cover; cursor: pointer;"
                             onclick="document.getElementById('mainBookImg').src = this.src;" />
                        @foreach (var img in Model.Book.DetailImages)
                        {
                            <img src="@img.ImageUrl"
                                 class="border rounded p-1"
                                 style="width: 60px; height: 80px; object-fit: cover; cursor: pointer;"
                                 onclick="document.getElementById('mainBookImg').src = this.src;" />
                        }
                    </div>
                }
            </div>

            <!-- BOOK INFO & ACTIONS -->
            <div class="col-md-7 col-lg-8">
                <h3 class="fw-bold text-dark mb-2">@Model.Book.Title</h3>

                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mb-3">
                    <div>Tác giả: <strong class="text-dark">@(Model.Book.Author ?? "Đang cập nhật")</strong></div>
                    <span>|</span>
                    <div>Nhà xuất bản: <strong class="text-dark">@(Model.Book.Publisher ?? "Đang cập nhật")</strong></div>
                    <span>|</span>
                    <div>Đã bán: <strong class="text-danger">@Model.Book.SoldQuantity</strong></div>
                </div>

                <!-- PRICE BOX -->
                <div class="p-3 rounded-3 bg-light mb-4">
                    <div class="d-flex align-items-baseline gap-3">
                        <span class="display-6 fw-bold text-danger">@Model.Book.Price.ToString("N0") <span class="fs-4">đ</span></span>
                        <span class="fs-5 text-muted text-decoration-line-through">@((Model.Book.Price * 1.25m).ToString("N0"))đ</span>
                        <span class="badge bg-danger rounded-pill px-3 py-2">-20%</span>
                    </div>
                </div>

                <!-- ======================== CELLPHONES-STYLE MULTI-WAREHOUSE STOCK WIDGET ======================== -->
                <div class="card border border-danger-subtle rounded-4 p-3 bg-light-subtle mb-4 shadow-sm">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                        <div class="fw-bold text-dark fs-6">
                            <i class="fa-solid fa-warehouse text-danger me-2"></i>Số lượng sách tại các kho hàng:
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-danger dropdown-toggle rounded-pill px-3 fw-semibold" type="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-location-dot me-1"></i>Khu vực xem: @Model.CurrentRegion
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                <li><a class="dropdown-item py-2" href="javascript:selectHeaderRegion('Miền Bắc (Hà Nội)')"><i class="fa-solid fa-building text-danger me-2"></i>Miền Bắc (Hà Nội)</a></li>
                                <li><a class="dropdown-item py-2" href="javascript:selectHeaderRegion('Miền Trung (Đà Nẵng)')"><i class="fa-solid fa-building text-warning me-2"></i>Miền Trung (Đà Nẵng)</a></li>
                                <li><a class="dropdown-item py-2" href="javascript:selectHeaderRegion('Miền Nam (TP.HCM)')"><i class="fa-solid fa-building text-primary me-2"></i>Miền Nam (TP.HCM)</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- 3 Regional Warehouse Cards -->
                    <div class="row g-2 mb-2">
                        @foreach (var wh in Model.WarehouseStocks)
                        {
                            string targetRegion = wh.WarehouseCode == "HN" 
                                ? "Miền Bắc (Hà Nội)" 
                                : (wh.WarehouseCode == "DN" ? "Miền Trung (Đà Nẵng)" : "Miền Nam (TP.HCM)");

                            <div class="col-md-4">
                                <div class="warehouse-card p-2 px-3 border rounded-3 h-100 d-flex flex-column justify-content-between @(wh.IsUserRegion ? "bg-danger-subtle border-danger border-2 shadow-sm" : "bg-white border-light-subtle")"
                                     onclick="selectHeaderRegion('@targetRegion')"
                                     role="button"
                                     tabindex="0"
                                     style="cursor: pointer; transition: all 0.2s ease-in-out; position: relative;"
                                     title="Bấm để chọn khu vực @targetRegion">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="fw-bold small text-dark">@wh.WarehouseName</span>
                                            @if (wh.IsUserRegion)
                                            {
                                                <span class="badge bg-danger rounded-pill px-2" style="font-size: 0.65rem;">
                                                    <i class="fa-solid fa-circle-check me-1"></i>Đang chọn
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border rounded-pill px-2 card-switch-hint" style="font-size: 0.65rem;">
                                                    <i class="fa-solid fa-hand-pointer me-1"></i>Bấm để chọn
                                                </span>
                                            }
                                        </div>
                                        <div class="text-muted small mb-2" style="font-size: 0.75rem;">
                                            <i class="fa-solid fa-cubes-stacked me-1"></i>@wh.ZoneLetter
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                        <span class="badge @wh.BadgeClass px-2 py-1">
                                            @(wh.StockQuantity > 0 ? $"Còn {wh.StockQuantity} cuốn" : "Hết hàng")
                                        </span>
                                        <span class="text-muted small" style="font-size: 0.75rem;">
                                            <i class="fa-solid fa-truck-fast text-secondary me-1"></i>@wh.DeliveryEstimate
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Dynamic cross-warehouse notice -->
                    <div id="crossWarehouseAlert" class="alert alert-info py-2 px-3 mt-2 mb-0 small d-flex align-items-center gap-2 @(Model.WarehouseStocks.FirstOrDefault(w => w.IsUserRegion)?.StockQuantity > 0 ? "d-none" : "")">
                        <i class="fa-solid fa-circle-info text-primary fs-5"></i>
                        <div>
                            <strong>Lưu ý giao hàng liên kho:</strong> Sách sẽ được điều chuyển từ tổng kho khác đến địa chỉ của bạn. Thời gian nhận hàng cam kết từ <strong>3 - 5 ngày (tối đa trong 5 ngày)</strong>.
                        </div>
                    </div>
                </div>

                <!-- QUANTITY & BUY BUTTONS -->
                @if (Model.Book.StockQuantity > 0)
                {
                    <form method="post" asp-page-handler="AddToCart" asp-route-id="@Model.Book.Id" class="mb-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <label class="form-label mb-0 fw-semibold">Số lượng:</label>
                            <div class="input-group" style="width: 130px;">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="changeQty(-1)">-</button>
                                <input type="number" id="qtyInput" name="quantity" value="1" min="1" max="@Model.Book.StockQuantity" oninput="checkCrossWarehouseStock(this.value)" class="form-control form-control-sm text-center fw-bold" />
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="changeQty(1)">+</button>
                            </div>
                            <span class="text-muted small">Tổng tồn toàn hệ thống: <strong>@Model.Book.StockQuantity</strong> cuốn</span>
                        </div>

                        <div class="d-flex flex-wrap gap-3">
                            <button type="submit" class="btn btn-outline-danger btn-lg px-4 fw-bold rounded-pill">
                                <i class="fa-solid fa-cart-plus me-2"></i>Thêm vào giỏ hàng
                            </button>
                            <button type="submit" name="buyNow" value="true" class="btn btn-danger btn-lg px-5 fw-bold rounded-pill shadow-sm">
                                <i class="fa-solid fa-bolt me-2"></i>Mua ngay
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-danger py-3 rounded-4 mb-4">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Sản phẩm tạm thời hết hàng trên toàn bộ các kho. Vui lòng quay lại sau!
                    </div>
                }

                <!-- POLICIES -->
                <div class="row g-2 border-top pt-4 text-muted small">
                    <div class="col-sm-4"><i class="fa-solid fa-truck-fast text-danger me-1"></i> Giao hàng toàn quốc</div>
                    <div class="col-sm-4"><i class="fa-solid fa-rotate-left text-danger me-1"></i> Đổi trả trong 7 ngày</div>
                    <div class="col-sm-4"><i class="fa-solid fa-shield-halved text-danger me-1"></i> Sách chính hãng 100%</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================== DETAILS & SPECIFICATIONS ======================== -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-align-left text-danger me-2"></i>Mô tả sản phẩm</h5>
                <div class="text-secondary lh-lg">
                    @(string.IsNullOrEmpty(Model.Book.Description) ? "Đang cập nhật nội dung mô tả..." : Model.Book.Description)
                </div>
            </div>

            <!-- REVIEWS SECTION -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-star text-warning me-2"></i>Đánh giá khách hàng (@Model.Book.Reviews.Count)
                    </h5>
                </div>

                <!-- ADD REVIEW FORM -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page-handler="AddReview" asp-route-id="@Model.Book.Id" class="p-3 bg-light rounded-3 mb-4">
                        <h6 class="fw-bold text-dark mb-2">Viết đánh giá của bạn</h6>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Đánh giá sao:</label>
                            <select asp-for="ReviewInput.Rating" class="form-select form-select-sm" style="max-width: 160px;">
                                <option value="5">⭐⭐⭐⭐⭐ (5 sao)</option>
                                <option value="4">⭐⭐⭐⭐ (4 sao)</option>
                                <option value="3">⭐⭐⭐ (3 sao)</option>
                                <option value="2">⭐⭐ (2 sao)</option>
                                <option value="1">⭐ (1 sao)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <textarea asp-for="ReviewInput.Comment" rows="3" class="form-control form-control-sm" placeholder="Chia sẻ cảm nhận của bạn về cuốn sách này..."></textarea>
                            <span asp-validation-for="ReviewInput.Comment" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold">Gửi đánh giá</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-light border small text-center mb-4">
                        Vui lòng <a asp-page="/Account/Login" asp-route-returnUrl="@Request.Path" class="text-danger fw-bold">Đăng nhập</a> để viết đánh giá cho sản phẩm này.
                    </div>
                }

                <!-- REVIEWS LIST -->
                @if (!Model.Book.Reviews.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên nhận xét!
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var review in Model.Book.Reviews)
                        {
                            <div class="border-bottom pb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="fw-bold text-dark">@(review.User?.FullName ?? "Khách hàng")</div>
                                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div class="text-warning small mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating) { <i class="fa-solid fa-star"></i> }
                                        else { <i class="fa-regular fa-star"></i> }
                                    }
                                </div>
                                <p class="text-secondary small mb-2">@review.Comment</p>

                                @if (!string.IsNullOrEmpty(review.StaffReply))
                                {
                                    <div class="p-2 rounded bg-danger-subtle border-start border-danger border-3 small ms-3">
                                        <strong class="text-danger"><i class="fa-solid fa-headset me-1"></i>Phản hồi từ MindBook:</strong>
                                        <div class="text-dark mt-1">@review.StaffReply</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- SPECIFICATIONS TABLE -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-circle-info text-danger me-2"></i>Thông tin chi tiết</h5>
                <table class="table table-sm small">
                    <tbody>
                        <tr>
                            <td class="text-muted">Mã ISBN:</td>
                            <td class="fw-semibold text-end">@(Model.Book.Isbn ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Nhà xuất bản:</td>
                            <td class="fw-semibold text-end">@(Model.Book.Publisher ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Năm xuất bản:</td>
                            <td class="fw-semibold text-end">@(Model.Book.YearOfPublish?.ToString() ?? "N/A")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Số trang:</td>
                            <td class="fw-semibold text-end">@(Model.Book.NumberOfPages?.ToString() ?? "N/A") trang</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Vị trí kho:</td>
                            <td class="fw-semibold text-end">@(Model.Book.LocationCode ?? "A-01-01")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- SUGGESTED BOOKS -->
            @if (Model.SuggestedBooks.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h6 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-thumbs-up text-danger me-2"></i>Có thể bạn cũng thích</h6>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var book in Model.SuggestedBooks)
                        {
                            <a asp-page="/Products/Detail" asp-route-id="@book.Id" class="d-flex gap-3 text-decoration-none text-dark">
                                <img src="@(string.IsNullOrEmpty(book.ImageUrl) ? "https://via.placeholder.com/60x80" : book.ImageUrl)"
                                     alt="@book.Title" class="rounded border" style="width: 55px; height: 75px; object-fit: cover;" />
                                <div>
                                    <div class="fw-bold small text-truncate-2" style="max-height: 38px; overflow: hidden;">@book.Title</div>
                                    <div class="text-danger fw-bold small mt-1">@book.Price.ToString("N0")đ</div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .warehouse-card {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        user-select: none;
    }
    .warehouse-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.15) !important;
        border-color: #dc3545 !important;
    }
    .warehouse-card:hover .card-switch-hint {
        background-color: #dc3545 !important;
        color: #fff !important;
        border-color: #dc3545 !important;
    }
</style>

<script>
    function changeQty(delta) {
        const input = document.getElementById('qtyInput');
        if (!input) return;
        let current = parseInt(input.value) || 1;
        let max = parseInt(input.max) || 999;
        let next = current + delta;
        if (next >= 1 && next <= max) {
            input.value = next;
            checkCrossWarehouseStock(next);
        }
    }

    function checkCrossWarehouseStock(val) {
        let quantity = parseInt(val) || 1;
        let localStock = @(Model.WarehouseStocks.FirstOrDefault(w => w.IsUserRegion)?.StockQuantity ?? 0);
        let alertBox = document.getElementById('crossWarehouseAlert');
        if (alertBox) {
            if (quantity > localStock) {
                alertBox.classList.remove('d-none');
            } else if (localStock > 0) {
                alertBox.classList.add('d-none');
            }
        }
    }
</script>
