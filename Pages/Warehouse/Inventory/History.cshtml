@page
@model BookStore.Pages.Warehouse.Inventory.HistoryModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lịch Sử Biến Động Kho";
    ViewData["Subtitle"] = "Theo dõi nhật ký các giao dịch nhập kho, xuất bán, kiểm kê và nhận hàng hoàn trả";
}

<div class="container-fluid px-0">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-page="/Warehouse/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>

        <h4 class="fw-bold text-dark m-0 text-center">
            <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>
            LỊCH SỬ BIẾN ĐỘNG KHO
        </h4>

        <div style="width: 120px;"></div>
    </div>

    <!-- FILTER -->
    <div class="bg-white p-3 rounded-4 shadow-sm mb-4">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" asp-for="Keyword" class="form-control" placeholder="Tìm theo tên sách..." />
                </div>
            </div>
            <div class="col-md-3">
                <select asp-for="Filter" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả biến động --</option>
                    <option value="IMPORT">⬇️ Nhập kho (IMPORT)</option>
                    <option value="EXPORT">⬆️ Xuất bán (EXPORT)</option>
                    <option value="ADJUSTMENT">⚙️ Kiểm kê (ADJUSTMENT)</option>
                    <option value="RETURN">🔄 Khách trả (RETURN)</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 fw-semibold">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <a asp-page="/Warehouse/Inventory/History" class="btn btn-secondary px-3 fw-semibold">
                    <i class="fa-solid fa-rotate-right me-1"></i> Làm mới
                </a>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle w-100 mb-0">
                <thead class="table-dark">
                    <tr class="text-center">
                        <th style="width: 5%;">STT</th>
                        <th style="width: 25%;" class="text-start">Tên sách</th>
                        <th style="width: 15%;">Loại giao dịch</th>
                        <th style="width: 12%;">Số lượng thay đổi</th>
                        <th style="width: 12%;">Mã liên kết</th>
                        <th style="width: 16%;">Thời gian</th>
                        <th style="width: 15%;">Người thực hiện</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Histories.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có lịch sử biến động nào phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        int index = 0;
                        foreach (var h in Model.Histories)
                        {
                            index++;
                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td class="text-start">
                                    <strong class="text-dark d-block">@(h.Book?.Title ?? "Sách #" + h.BookId)</strong>
                                    <small class="text-muted">Vị trí: <strong class="text-info">@(h.Book?.LocationCode ?? "N/A")</strong></small>
                                </td>
                                <td class="text-center">
                                    @switch (h.TransactionType.ToUpper())
                                    {
                                        case "IMPORT":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold">
                                                <i class="fa-solid fa-arrow-down me-1"></i> Nhập kho
                                            </span>
                                            break;
                                        case "EXPORT":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-bold">
                                                <i class="fa-solid fa-arrow-up me-1"></i> Xuất bán
                                            </span>
                                            break;
                                        case "RETURN":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 fw-bold">
                                                <i class="fa-solid fa-rotate-left me-1"></i> Hàng trả lại
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-bold">
                                                <i class="fa-solid fa-sliders me-1"></i> Kiểm kê
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-center fw-bold fs-6">
                                    @if (h.QuantityChanged > 0)
                                    {
                                        <span class="text-success">+@h.QuantityChanged</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@h.QuantityChanged</span>
                                    }
                                </td>
                                <td class="text-center text-muted font-monospace small">
                                    @(h.RelatedId.HasValue ? "#" + h.RelatedId.Value : "-")
                                </td>
                                <td class="text-center">@h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @(h.CreatedBy?.FullName ?? h.CreatedBy?.UserName ?? "Hệ thống")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
