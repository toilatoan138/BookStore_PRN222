@page
@model BookStore.Pages.Warehouse.Returns.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Đơn Trả Hàng";
    ViewData["Subtitle"] = "Theo dõi các yêu cầu đổi trả sách và kiểm định chất lượng (QC Inspection) nhập lại kho";
}

<div class="container-fluid px-0">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-page="/Warehouse/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>

        <h4 class="fw-bold text-dark m-0 text-center" style="color: #fd7e14 !important;">
            <i class="fa-solid fa-rotate-left me-2"></i>
            DANH SÁCH ĐƠN TRẢ HÀNG
        </h4>

        <div style="width: 120px;"></div>
    </div>

    <!-- FILTER -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold small text-muted">Tìm kiếm Khách hàng</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" asp-for="SearchName" class="form-control" placeholder="Nhập tên khách hàng hoặc SĐT..." />
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Trạng thái hoàn trả</label>
                <select asp-for="StatusFilter" class="form-select">
                    <option value="-1">-- Tất cả trạng thái --</option>
                    <option value="0">Pending Review (Chờ Staff duyệt)</option>
                    <option value="1">Approved (Đã duyệt - Chờ nhận hàng & Kiểm QC)</option>
                    <option value="2">Rejected (Bị từ chối)</option>
                    <option value="3">Completed (Đã kiểm QC & Nhập lại kho)</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50 fw-semibold">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <a asp-page="/Warehouse/Returns/Index" class="btn btn-secondary w-50 fw-semibold">
                    <i class="fa-solid fa-rotate-right me-1"></i> Làm mới
                </a>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle w-100 mb-0">
                <thead class="table-dark">
                    <tr class="text-center">
                        <th style="width: 5%;">STT</th>
                        <th style="width: 10%;">Mã Trả</th>
                        <th style="width: 10%;">Mã Đơn</th>
                        <th style="width: 18%;" class="text-start">Khách Hàng</th>
                        <th style="width: 20%;" class="text-start">Sách & Số Lượng</th>
                        <th style="width: 15%;" class="text-start">Lý Do Trả</th>
                        <th style="width: 12%;">Trạng Thái</th>
                        <th style="width: 10%;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ReturnRequests.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Không có yêu cầu trả hàng nào phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        int index = 0;
                        foreach (var r in Model.ReturnRequests)
                        {
                            index++;
                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td class="text-center fw-bold font-monospace text-warning">#RET-@r.ReturnId</td>
                                <td class="text-center fw-bold font-monospace">
                                    <a asp-page="/Warehouse/Orders/Index" asp-route-search="@r.OrderId" class="text-decoration-none text-primary">
                                        #ORD-@r.OrderId
                                    </a>
                                </td>
                                <td class="text-start">
                                    <strong class="text-dark d-block">@(r.Order?.FullName ?? r.Order?.User?.FullName ?? "Khách hàng")</strong>
                                    <small class="text-muted"><i class="fa-solid fa-phone me-1"></i>@(r.Order?.PhoneNumber ?? "N/A")</small>
                                </td>
                                <td class="text-start">
                                    <strong class="text-dark d-block">@(r.Book?.Title ?? "Sách #" + r.BookId)</strong>
                                    <small class="text-danger fw-bold">Số lượng trả: @r.Quantity quyển</small>
                                </td>
                                <td class="text-start small fst-italic text-muted">
                                    @r.CustomerReason
                                </td>
                                <td class="text-center">
                                    @switch (r.Status)
                                    {
                                        case 0:
                                            <span class="badge bg-warning text-dark px-2 py-1">Chờ duyệt</span>
                                            break;
                                        case 1:
                                            <span class="badge bg-info text-dark px-2 py-1">Chờ kiểm QC</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-danger px-2 py-1">Bị từ chối</span>
                                            break;
                                        case 3:
                                            <span class="badge bg-success px-2 py-1">Đã nhập kho</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-2 py-1">Khác</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    @if (r.Status == 1)
                                    {
                                        <a asp-page="/Warehouse/Returns/Inspect" asp-route-id="@r.ReturnId"
                                           class="btn btn-sm btn-warning text-dark rounded-pill px-3 fw-bold shadow-sm" title="Kiểm định QC">
                                            <i class="fa-solid fa-magnifying-glass-check me-1"></i>QC Inspect
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                data-bs-toggle="modal" data-bs-target="#returnDetailModal-@r.ReturnId">
                                            <i class="fa-solid fa-eye me-1"></i>Xem
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL VIEW DETAIL CHO TỪNG RETURN REQUEST -->
@foreach (var r in Model.ReturnRequests)
{
    <div class="modal fade" id="returnDetailModal-@r.ReturnId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-rotate-left me-2"></i>Yêu Cầu Hoàn Trả #RET-@r.ReturnId
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <small class="text-muted d-block">Sách hoàn trả:</small>
                        <strong class="text-dark fs-6">@(r.Book?.Title ?? "Sách #" + r.BookId)</strong>
                        <div class="text-danger fw-bold">Số lượng yêu cầu: @r.Quantity quyển</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block">Lý do khách cung cấp:</small>
                        <div class="p-3 bg-light rounded border text-muted">@r.CustomerReason</div>
                    </div>

                    @if (!string.IsNullOrEmpty(r.AdminNote))
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Ghi chú từ Nhân viên/Admin:</small>
                            <div class="p-2 bg-info-subtle rounded border border-info-subtle text-dark">@r.AdminNote</div>
                        </div>
                    }

                    <div class="row g-2 small text-muted">
                        <div class="col-6">Ngày gửi yêu cầu: @r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-6">Phương thức hoàn tiền: @(r.RefundPreference ?? "Ví MindBook")</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}
