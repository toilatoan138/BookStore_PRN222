@page
@model BookStore.Pages.Warehouse.Returns.InspectModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kiểm Hàng Hoàn Trả (QC Inspection)";
    ViewData["Subtitle"] = "Kiểm định số lượng và chất lượng thực tế của sách hoàn trả trước khi nhập kho";
}

@section Styles {
    <style>
        .row-inspected {
            background-color: #fff4e5 !important;
            transition: background-color 0.3s;
        }
        .checkbox-lg {
            width: 22px;
            height: 22px;
            cursor: pointer;
        }
    </style>
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-page="/Warehouse/Returns/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>

        <h4 class="fw-bold text-dark m-0" style="color: #fd7e14 !important;">
            <i class="fa-solid fa-box-open me-2"></i>
            Kiểm Hàng Hoàn Trả
        </h4>

        <div style="width: 100px;"></div>
    </div>

    @if (Model.ReturnItem != null)
    {
        <div class="bg-white p-4 rounded-4 shadow-sm mb-4 border-start border-4" style="border-color: #fd7e14 !important;">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">Yêu cầu #RET-@Model.ReturnItem.ReturnId (Đơn #ORD-@Model.ReturnItem.OrderId)</h5>
                    <small class="text-muted">Khách hàng: <strong>@(Model.ReturnItem.Order?.FullName ?? Model.ReturnItem.Order?.User?.FullName ?? "N/A")</strong></small>
                </div>
                <span class="badge bg-warning text-dark px-3 py-2 fw-semibold">Đang kiểm định QC</span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted d-block">Sách khách hoàn trả:</small>
                    <strong class="text-dark fs-6">@(Model.ReturnItem.Book?.Title ?? "Sách #" + Model.ReturnItem.BookId)</strong>
                    <div class="small text-muted mt-1">Vị trí kệ cất sách: <strong class="text-info">@(Model.ReturnItem.Book?.LocationCode ?? "A-01-01")</strong></div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Lý do từ khách hàng:</small>
                    <div class="p-2 bg-light rounded border text-muted small fst-italic">
                        @Model.ReturnItem.CustomerReason
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-page-handler="PassQC" asp-route-returnId="@Model.ReturnItem.ReturnId" onsubmit="return validateInspectForm()">
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center" style="width: 10%;">
                                    <input type="checkbox" id="checkAll" class="form-check-input checkbox-lg" onchange="toggleAllInspect(this)" />
                                </th>
                                <th style="width: 50%;">Tên Sách Hoàn Trả</th>
                                <th class="text-center" style="width: 20%;">Số Lượng Nhận Lại</th>
                                <th class="text-center" style="width: 20%;">Tình Trạng Sách</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="item-row">
                                <td class="text-center">
                                    <input type="checkbox" id="inspectCb" class="form-check-input inspect-checkbox checkbox-lg"
                                           data-qty="@Model.ReturnItem.Quantity"
                                           onchange="handleInspectCheck(this)" />
                                </td>
                                <td class="fw-bold text-dark">
                                    @(Model.ReturnItem.Book?.Title ?? "Sách #" + Model.ReturnItem.BookId)
                                </td>
                                <td class="text-center fs-5 fw-bold text-danger">
                                    @Model.ReturnItem.Quantity quyển
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
                                        <i class="fa-solid fa-circle-check me-1"></i> Nguyên vẹn / Tái nhập kho
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="mb-3 mt-4">
                    <label class="form-label fw-bold small text-muted">Ghi chú kiểm định QC của Nhân viên kho</label>
                    <textarea name="qcNote" class="form-control" rows="2" placeholder="Ghi chú tình trạng sách thực tế khi mở kiện hàng..."></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div>
                        <span class="fw-bold fs-6 text-dark">Số lượng đã kiểm: </span>
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2" id="checkedCount">0 / @Model.ReturnItem.Quantity quyển</span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" formaction="?handler=RejectQC&returnId=@Model.ReturnItem.ReturnId" class="btn btn-outline-danger btn-lg rounded-pill px-4 fw-bold"
                                onclick="return confirm('Bạn có chắc chắn muốn từ chối yêu cầu trả hàng này do không đạt tiêu chuẩn QC?');">
                            <i class="fa-solid fa-ban me-2"></i> Từ chối QC
                        </button>
                        <button type="submit" id="submitQCBtn" class="btn btn-success btn-lg rounded-pill px-4 fw-bold shadow disabled">
                            <i class="fa-solid fa-check-circle me-2"></i> Đạt QC & Hoàn Nhập Kho
                        </button>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        function handleInspectCheck(cb) {
            const row = cb.closest('tr');
            if (cb.checked) {
                row.classList.add('row-inspected');
            } else {
                row.classList.remove('row-inspected');
            }
            updateQCProgress();
        }

        function toggleAllInspect(master) {
            const cb = document.getElementById('inspectCb');
            if (cb) {
                cb.checked = master.checked;
                handleInspectCheck(cb);
            }
        }

        function updateQCProgress() {
            const cb = document.getElementById('inspectCb');
            const qty = cb && cb.checked ? parseInt(cb.getAttribute('data-qty')) : 0;
            const total = cb ? parseInt(cb.getAttribute('data-qty')) : 0;

            document.getElementById('checkedCount').innerText = `${qty} / ${total} quyển`;

            const btn = document.getElementById('submitQCBtn');
            const checkAll = document.getElementById('checkAll');

            if (cb && cb.checked) {
                btn.classList.remove('disabled');
                checkAll.checked = true;
            } else {
                btn.classList.add('disabled');
                checkAll.checked = false;
            }
        }

        function validateInspectForm() {
            const cb = document.getElementById('inspectCb');
            if (!cb || !cb.checked) {
                alert("Vui lòng tích chọn xác nhận đã kiểm tra sách hoàn trả trước khi lưu!");
                return false;
            }
            return confirm("Xác nhận sách đạt tiêu chuẩn QC và hoàn nhập số lượng vào kho lưu trữ?");
        }
    </script>
}
