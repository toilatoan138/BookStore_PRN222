@page
@model BookStore.Pages.Warehouse.Orders.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Xuất Kho & Đơn Hàng";
    ViewData["Subtitle"] = "Kiểm tra danh sách đơn cần nhặt hàng (Picking), đóng gói và bàn giao xuất kho vận chuyển";
}

<div class="container-fluid px-0">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-page="/Warehouse/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>

        <h4 class="fw-bold text-danger m-0 text-center">
            <i class="fa-solid fa-clipboard-check me-2"></i>
            QUẢN LÝ XUẤT KHO & ĐƠN HÀNG
        </h4>

        <div style="width: 120px;"></div>
    </div>

    <!-- FILTER -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold small text-muted">Tên Khách Hàng / SĐT</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" asp-for="Search" class="form-control" placeholder="Nhập tên khách hoặc số điện thoại..." />
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Trạng thái đơn hàng</label>
                <select asp-for="Status" class="form-select">
                    <option value="0">-- Tất cả trạng thái --</option>
                    <option value="2">Processing (Chờ lấy hàng / Picking)</option>
                    <option value="3">Packed (Đã soạn hàng / Chờ xuất kho)</option>
                    <option value="4">Shipping (Đang giao hàng)</option>
                    <option value="5">Delivered (Đã giao thành công)</option>
                    <option value="6">Cancelled (Đã hủy)</option>
                    <option value="7">ReturnRequested (Yêu cầu hoàn trả)</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-danger w-50 fw-semibold">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <a asp-page="/Warehouse/Orders/Index" class="btn btn-secondary w-50 fw-semibold">
                    <i class="fa-solid fa-rotate-right me-1"></i> Làm mới
                </a>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle w-100 mb-0">
                <thead class="table-dark">
                    <tr class="text-center">
                        <th style="width: 5%;">STT</th>
                        <th style="width: 10%;">Mã Đơn</th>
                        <th style="width: 18%;" class="text-start">Khách Hàng</th>
                        <th style="width: 22%;" class="text-start">Địa Chỉ Giao Hàng</th>
                        <th style="width: 13%;">Ngày Đặt</th>
                        <th style="width: 12%;">Tổng Tiền</th>
                        <th style="width: 10%;">Trạng Thái</th>
                        <th style="width: 10%;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Không có đơn hàng nào phù hợp điều kiện lọc.</td>
                        </tr>
                    }
                    else
                    {
                        int index = 0;
                        foreach (var o in Model.Orders)
                        {
                            index++;
                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td class="text-center fw-bold font-monospace text-primary">#ORD-@o.Id</td>
                                <td class="text-start">
                                    <strong class="text-dark d-block">@(o.FullName ?? o.User?.FullName ?? "Khách vãng lai")</strong>
                                    <small class="text-muted"><i class="fa-solid fa-phone me-1"></i>@o.PhoneNumber</small>
                                </td>
                                <td class="text-start small">@o.ShippingAddress</td>
                                <td class="text-center small">@o.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end fw-bold text-danger">@o.TotalAmount.ToString("N0")đ</td>
                                <td class="text-center">
                                    @switch (o.Status)
                                    {
                                        case BookStore.Models.Enums.OrderStatus.Processing:
                                            <span class="badge bg-warning text-dark px-2 py-1">Chờ lấy hàng</span>
                                            break;
                                        case BookStore.Models.Enums.OrderStatus.Packed:
                                            <span class="badge bg-info text-dark px-2 py-1">Đã soạn xong</span>
                                            break;
                                        case BookStore.Models.Enums.OrderStatus.Shipping:
                                            <span class="badge bg-primary px-2 py-1">Đang giao</span>
                                            break;
                                        case BookStore.Models.Enums.OrderStatus.Delivered:
                                            <span class="badge bg-success px-2 py-1">Đã giao</span>
                                            break;
                                        case BookStore.Models.Enums.OrderStatus.Cancelled:
                                            <span class="badge bg-secondary px-2 py-1">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border px-2 py-1">@o.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 me-1"
                                            title="Xem chi tiết"
                                            data-bs-toggle="modal" data-bs-target="#orderDetailModal-@o.Id">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>

                                    @if (o.Status == BookStore.Models.Enums.OrderStatus.Processing)
                                    {
                                        <a asp-page="/Warehouse/Orders/Picking" asp-route-orderId="@o.Id"
                                           class="btn btn-sm btn-danger rounded-pill px-3 fw-bold shadow-sm" title="Lấy hàng">
                                            <i class="fa-solid fa-boxes-packing me-1"></i>Picking
                                        </a>
                                    }
                                    else if (o.Status == BookStore.Models.Enums.OrderStatus.Packed)
                                    {
                                        <form method="post" asp-page-handler="ShipOrder" asp-route-orderId="@o.Id" class="d-inline"
                                              onsubmit="return confirm('Xác nhận đã đóng gói và xuất kho giao hàng cho đơn này?');">
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-2 fw-bold" title="Xuất kho">
                                                <i class="fa-solid fa-truck-fast me-1"></i>Xuất kho
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL XEM CHI TIẾT ĐƠN HÀNG -->
@foreach (var o in Model.Orders)
{
    <div class="modal fade" id="orderDetailModal-@o.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-box-open me-2"></i>Chi Tiết Đơn Hàng #ORD-@o.Id
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4 bg-light p-3 rounded-3 mx-0 border">
                        <div class="col-6">
                            <small class="text-muted d-block">Khách nhận:</small>
                            <strong class="text-dark">@(o.FullName ?? o.User?.FullName ?? "Khách vãng lai")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Số điện thoại:</small>
                            <strong class="text-dark">@o.PhoneNumber</strong>
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block">Địa chỉ nhận hàng:</small>
                            <strong class="text-dark">@o.ShippingAddress</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Ngày đặt hàng:</small>
                            <strong class="text-dark">@o.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Hình thức thanh toán:</small>
                            <span class="badge bg-secondary">@(o.PaymentMethod ?? "COD")</span>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-list me-2 text-danger"></i>Danh Sách Sản Phẩm</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên sách</th>
                                    <th class="text-center">Vị trí kệ</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int itmIdx = 0;
                                    foreach (var d in o.Details)
                                    {
                                        itmIdx++;
                                        <tr>
                                            <td class="text-center fw-bold text-muted">@itmIdx</td>
                                            <td class="fw-semibold">@(d.Book?.Title ?? "Sách #" + d.BookId)</td>
                                            <td class="text-center fw-bold text-info">@(d.Book?.LocationCode ?? "A-01-01")</td>
                                            <td class="text-center fw-bold fs-6 text-danger">@d.Quantity</td>
                                            <td class="text-end">@d.Price.ToString("N0")đ</td>
                                            <td class="text-end fw-bold">@((d.Quantity * d.Price).ToString("N0"))đ</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="5" class="text-end fw-bold">TỔNG TIỀN ĐƠN:</th>
                                    <th class="text-end text-danger fw-bold fs-6">@o.TotalAmount.ToString("N0")đ</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    @if (o.Status == BookStore.Models.Enums.OrderStatus.Processing)
                    {
                        <a asp-page="/Warehouse/Orders/Picking" asp-route-orderId="@o.Id" class="btn btn-danger rounded-pill px-4 fw-bold">
                            <i class="fa-solid fa-boxes-packing me-1"></i>Lấy Hàng (Picking)
                        </a>
                    }
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}
