@page
@model BookStore.Pages.Warehouse.Orders.PickingModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thực hiện Lấy Hàng (Picking List)";
    ViewData["Subtitle"] = "Thu thập sách từ các kệ theo đơn hàng";
}

@section Styles {
    <style>
        .row-picked {
            background-color: #d1e7dd !important;
            transition: background-color 0.3s;
        }
        .checkbox-lg {
            width: 22px;
            height: 22px;
            cursor: pointer;
        }
    </style>
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark m-0">
            <i class="fa-solid fa-boxes-packing text-primary me-2"></i>
            Danh Sách Lấy Hàng (Picking List)
        </h4>
        <a asp-page="/Warehouse/Orders/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (Model.OrderInfo != null)
    {
        <!-- ORDER INFO BOX -->
        <div class="bg-white p-4 rounded-4 shadow-sm mb-4 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h5 class="fw-bold text-primary mb-0">Đơn hàng #ORD-@Model.OrderInfo.Id</h5>
                <span class="badge bg-warning text-dark px-3 py-2">Đang soạn hàng</span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <p class="mb-1 text-muted small">Khách hàng nhận:</p>
                    <strong class="text-dark">@(Model.OrderInfo.FullName ?? Model.OrderInfo.User?.FullName ?? "Khách vãng lai")</strong>
                    <div class="small text-muted mt-1"><i class="fa-solid fa-phone me-1"></i>@Model.OrderInfo.PhoneNumber</div>
                </div>
                <div class="col-md-6">
                    <p class="mb-1 text-muted small">Địa chỉ giao hàng:</p>
                    <strong class="text-dark">@Model.OrderInfo.ShippingAddress</strong>
                    <div class="small text-muted mt-1"><i class="fa-solid fa-calendar me-1"></i>Ngày đặt: @Model.OrderInfo.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- PICKING ITEMS FORM -->
        <form method="post" asp-page-handler="CompletePicking" asp-route-orderId="@Model.OrderInfo.Id" onsubmit="return validatePickingForm()">
            <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-bordered mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center" style="width: 5%;">STT</th>
                                <th style="width: 40%;">Tên Sách</th>
                                <th class="text-center" style="width: 20%;">Vị trí kho (Kệ)</th>
                                <th class="text-center" style="width: 20%;">Số Lượng Cần Lấy</th>
                                <th class="text-center" style="width: 15%;">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <input type="checkbox" id="checkAll" class="form-check-input checkbox-lg" onchange="toggleAllPicking(this)" />
                                        <label for="checkAll" class="small text-white ms-1 mb-0" style="cursor: pointer;">Tất cả</label>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int pIdx = 0;
                                int totalNeeded = 0;
                                foreach (var item in Model.OrderInfo.Details)
                                {
                                    pIdx++;
                                    totalNeeded += item.Quantity;
                                    <tr class="item-row">
                                        <td class="text-center fw-bold text-muted">@pIdx</td>
                                        <td class="fw-bold text-dark">
                                            @(item.Book?.Title ?? "Sách #" + item.BookId)
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 fw-bold font-monospace fs-6">
                                                @(item.Book?.LocationCode ?? "A-01-01")
                                            </span>
                                        </td>
                                        <td class="text-center fs-5 fw-bold text-danger qty-val">
                                            @item.Quantity
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input item-checkbox checkbox-lg"
                                                   data-qty="@item.Quantity"
                                                   onchange="handleRowCheck(this)" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div>
                        <span class="fw-bold fs-6 text-dark">Tiến độ nhặt hàng: </span>
                        <span class="badge bg-primary fs-6 px-3 py-2" id="progressBadge">0 / @totalNeeded quyển</span>
                    </div>

                    <button type="submit" id="submitPickingBtn" class="btn btn-success btn-lg rounded-pill px-4 fw-bold shadow disabled">
                        <i class="fa-solid fa-check-double me-2"></i> Xác nhận đã soạn đủ hàng (Hoàn thành Picking)
                    </button>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        function handleRowCheck(cb) {
            const row = cb.closest('tr');
            if (cb.checked) {
                row.classList.add('row-picked');
            } else {
                row.classList.remove('row-picked');
            }
            updateProgress();
        }

        function toggleAllPicking(master) {
            const checkboxes = document.querySelectorAll('.item-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = master.checked;
                const row = cb.closest('tr');
                if (cb.checked) {
                    row.classList.add('row-picked');
                } else {
                    row.classList.remove('row-picked');
                }
            });
            updateProgress();
        }

        function updateProgress() {
            const checkboxes = document.querySelectorAll('.item-checkbox');
            let total = 0;
            let checked = 0;

            checkboxes.forEach(cb => {
                const qty = parseInt(cb.getAttribute('data-qty')) || 1;
                total += qty;
                if (cb.checked) checked += qty;
            });

            document.getElementById('progressBadge').innerText = `${checked} / ${total} quyển`;

            const btn = document.getElementById('submitPickingBtn');
            const checkAll = document.getElementById('checkAll');

            if (checked === total && total > 0) {
                btn.classList.remove('disabled');
                checkAll.checked = true;
            } else {
                btn.classList.add('disabled');
                checkAll.checked = false;
            }
        }

        function validatePickingForm() {
            const checkboxes = document.querySelectorAll('.item-checkbox');
            for (let cb of checkboxes) {
                if (!cb.checked) {
                    alert("Vui lòng tích chọn xác nhận đã nhặt đầy đủ tất cả các sách trong đơn hàng!");
                    return false;
                }
            }
            return confirm("Xác nhận đã soạn đủ toàn bộ sách và sẵn sàng đóng gói đơn hàng?");
        }
    </script>
}
