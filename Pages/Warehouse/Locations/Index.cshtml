@page
@model BookStore.Pages.Warehouse.Locations.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thiết Lập Vị Trí Kho";
    ViewData["Subtitle"] = "Định vị Zone, Rack, Shelf để phân loại và sắp xếp sách chuẩn xác";
}

<div class="container-fluid px-0">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- LEFT -->
        <a asp-page="/Warehouse/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>

        <!-- CENTER -->
        <h4 class="fw-bold text-info m-0 text-center">
            <i class="fa-solid fa-map-location-dot me-2"></i>
            THIẾT LẬP VỊ TRÍ KHO
        </h4>

        <!-- RIGHT -->
        <button type="button" class="btn btn-info text-white btn-sm shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#addLocationModal">
            <i class="fa-solid fa-plus me-1"></i> Thêm Vị Trí
        </button>
    </div>

    <!-- FILTER THEO KHU (ZONE) -->
    <div class="bg-white p-3 rounded-4 shadow-sm mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold small text-muted">Lọc theo Khu (Zone):</label>
            </div>
            <div class="col-auto">
                <select asp-for="SelectedZone" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả các khu --</option>
                    @foreach (var z in Model.ZoneList)
                    {
                        <option value="@z">Khu @z</option>
                    }
                </select>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white p-4 rounded-4 shadow-sm border-top border-info border-4 mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle w-100 mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 5%;">STT</th>
                        <th class="text-center" style="width: 15%;">Mã Vị Trí</th>
                        <th class="text-center" style="width: 10%;">Khu (Zone)</th>
                        <th class="text-center" style="width: 10%;">Kệ (Rack)</th>
                        <th class="text-center" style="width: 10%;">Tầng (Shelf)</th>
                        <th style="width: 20%;">Dành cho Thể loại</th>
                        <th style="width: 20%;">Ghi chú</th>
                        <th class="text-center" style="width: 10%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Locations.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có vị trí kệ nào trong khu vực này.</td>
                        </tr>
                    }
                    else
                    {
                        int index = 0;
                        foreach (var l in Model.Locations)
                        {
                            index++;
                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 fw-bold font-monospace">
                                        @l.LocationCode
                                    </span>
                                </td>
                                <td class="text-center fw-bold">@l.Zone</td>
                                <td class="text-center">@l.Rack</td>
                                <td class="text-center">@l.Shelf</td>
                                <td>
                                    @if (l.Category != null)
                                    {
                                        <span class="badge bg-light text-dark border">@l.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tất cả / Chung</span>
                                    }
                                </td>
                                <td>@(l.Description ?? "N/A")</td>
                                <td class="text-center text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 me-1"
                                            title="Sửa"
                                            onclick="openEditLocationModal(@l.Id, '@l.Zone', '@l.Rack', '@l.Shelf', @(l.CategoryId ?? 0), '@Html.Raw(Html.Encode(l.Description ?? ""))')">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@l.Id" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa vị trí kệ này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================= MODAL ADD LOCATION ======================= -->
<div class="modal fade" id="addLocationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2"></i>Thêm Vị Trí Kệ Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="form-label fw-bold small text-muted">Khu (Zone) *</label>
                            <input type="text" asp-for="Input.Zone" class="form-control text-uppercase" required placeholder="A, B, C" />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold small text-muted">Kệ (Rack) *</label>
                            <input type="text" asp-for="Input.Rack" class="form-control text-uppercase" required placeholder="01, 02" />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold small text-muted">Tầng (Shelf) *</label>
                            <input type="text" asp-for="Input.Shelf" class="form-control text-uppercase" required placeholder="01, 02" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Gán cho Thể loại</label>
                        <select asp-for="Input.CategoryId" class="form-select">
                            <option value="0">-- Dành cho mọi thể loại (Chung) --</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Ghi chú vị trí</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="2" placeholder="VD: Gần cửa xuất hàng, khu vực sách mới..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold">Thêm Vị Trí</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================= MODAL EDIT LOCATION ======================= -->
<div class="modal fade" id="editLocationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Cập Nhật Vị Trí Kệ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body p-4">
                    <input type="hidden" asp-for="Input.Id" id="editLocId" />

                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="form-label fw-bold small text-muted">Khu (Zone) *</label>
                            <input type="text" asp-for="Input.Zone" id="editLocZone" class="form-control text-uppercase" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold small text-muted">Kệ (Rack) *</label>
                            <input type="text" asp-for="Input.Rack" id="editLocRack" class="form-control text-uppercase" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold small text-muted">Tầng (Shelf) *</label>
                            <input type="text" asp-for="Input.Shelf" id="editLocShelf" class="form-control text-uppercase" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Gán cho Thể loại</label>
                        <select asp-for="Input.CategoryId" id="editLocCategory" class="form-select">
                            <option value="0">-- Dành cho mọi thể loại (Chung) --</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Ghi chú vị trí</label>
                        <textarea asp-for="Input.Description" id="editLocDesc" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Lưu Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditLocationModal(id, zone, rack, shelf, categoryId, desc) {
            document.getElementById('editLocId').value = id;
            document.getElementById('editLocZone').value = zone;
            document.getElementById('editLocRack').value = rack;
            document.getElementById('editLocShelf').value = shelf;
            document.getElementById('editLocCategory').value = categoryId;
            document.getElementById('editLocDesc').value = desc;
            new bootstrap.Modal(document.getElementById('editLocationModal')).show();
        }
    </script>
}
