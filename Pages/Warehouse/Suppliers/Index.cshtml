@page
@model BookStore.Pages.Warehouse.Suppliers.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Nhà Cung Cấp";
    ViewData["Subtitle"] = "Quản lý danh sách đối tác cung ứng sách, thông tin liên hệ và trạng thái lưu trữ";
}

<div class="container-fluid px-0">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- LEFT -->
        <a asp-page="/Warehouse/Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>

        <!-- CENTER TITLE -->
        <h4 class="fw-bold text-success m-0 text-center">
            <i class="fa-solid fa-truck-fast me-2"></i>
            NHÀ CUNG CẤP
        </h4>

        <!-- RIGHT BUTTONS -->
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-dark btn-sm shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#archiveModal">
                <i class="fa-solid fa-box-archive me-1"></i> Kho lưu trữ (@Model.DeletedSuppliers.Count)
            </button>
            <button type="button" class="btn btn-success btn-sm shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#addModal">
                <i class="fa-solid fa-plus me-1"></i> Thêm mới
            </button>
        </div>
    </div>

    <!-- TABLE ACTIVE -->
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle w-100 mb-0">
                <thead class="table-success">
                    <tr>
                        <th class="text-center" style="width: 5%;">STT</th>
                        <th style="width: 22%;">Tên Nhà Cung Cấp</th>
                        <th style="width: 15%;">Người liên hệ</th>
                        <th style="width: 12%;">Điện thoại</th>
                        <th style="width: 18%;">Email</th>
                        <th style="width: 18%;">Địa chỉ</th>
                        <th class="text-center" style="width: 10%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Suppliers.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu nhà cung cấp nào đang hoạt động.</td>
                        </tr>
                    }
                    else
                    {
                        int index = 0;
                        foreach (var s in Model.Suppliers)
                        {
                            index++;
                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td class="fw-bold text-dark">@s.Name</td>
                                <td>@(s.ContactPerson ?? "N/A")</td>
                                <td>@(s.Phone ?? "N/A")</td>
                                <td>@(s.Email ?? "N/A")</td>
                                <td>@(s.Address ?? "N/A")</td>
                                <td class="text-center text-nowrap">
                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-2 me-1"
                                            title="Chỉnh sửa"
                                            onclick="openEditSupplierModal(@s.Id, '@Html.Raw(Html.Encode(s.Name))', '@Html.Raw(Html.Encode(s.ContactPerson ?? ""))', '@(s.Phone ?? "")', '@(s.Email ?? "")', '@Html.Raw(Html.Encode(s.Address ?? ""))')">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn chuyển nhà cung cấp này vào kho lưu trữ?');">
                                        <button type="submit" class="btn btn-sm btn-danger rounded-pill px-2" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================= MODAL KHO LƯU TRỮ ======================= -->
<div class="modal fade" id="archiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-box-archive me-2"></i> Kho Lưu Trữ Nhà Cung Cấp Đã Xóa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                @if (!Model.DeletedSuppliers.Any())
                {
                    <p class="text-center text-muted py-3 mb-0">Kho lưu trữ trống (không có NCC nào bị xóa).</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên Nhà Cung Cấp</th>
                                    <th>Người liên hệ</th>
                                    <th>Điện thoại</th>
                                    <th class="text-center">Khôi phục</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sd in Model.DeletedSuppliers)
                                {
                                    <tr>
                                        <td class="fw-bold">@sd.Name</td>
                                        <td>@(sd.ContactPerson ?? "N/A")</td>
                                        <td>@(sd.Phone ?? "N/A")</td>
                                        <td class="text-center">
                                            <form method="post" asp-page-handler="Restore" asp-route-id="@sd.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                                    <i class="fa-solid fa-rotate-left me-1"></i> Khôi phục
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ======================= MODAL ADD ======================= -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2"></i>Thêm Nhà Cung Cấp Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tên Nhà Cung Cấp *</label>
                        <input type="text" asp-for="Input.Name" class="form-control" required minlength="2" placeholder="VD: NXB Trẻ, Fahasa..." />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Người đại diện liên hệ</label>
                        <input type="text" asp-for="Input.ContactPerson" class="form-control" placeholder="VD: Nguyễn Văn A" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Điện thoại *</label>
                            <input type="text" asp-for="Input.Phone" class="form-control" required placeholder="VD: 0901234567" />
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Email *</label>
                            <input type="email" asp-for="Input.Email" class="form-control" required placeholder="contact@nxb.vn" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Địa chỉ *</label>
                        <textarea asp-for="Input.Address" class="form-control" rows="2" required placeholder="Địa chỉ kho / trụ sở"></textarea>
                        <span asp-validation-for="Input.Address" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Thêm Mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================= MODAL EDIT ======================= -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Cập Nhật Nhà Cung Cấp</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body p-4">
                    <input type="hidden" asp-for="Input.Id" id="editId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tên Nhà Cung Cấp *</label>
                        <input type="text" asp-for="Input.Name" id="editName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Người đại diện liên hệ</label>
                        <input type="text" asp-for="Input.ContactPerson" id="editContactPerson" class="form-control" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Điện thoại *</label>
                            <input type="text" asp-for="Input.Phone" id="editPhone" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Email *</label>
                            <input type="email" asp-for="Input.Email" id="editEmail" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Địa chỉ *</label>
                        <textarea asp-for="Input.Address" id="editAddress" class="form-control" rows="2" required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Lưu Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditSupplierModal(id, name, contact, phone, email, address) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editContactPerson').value = contact;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editEmail').value = email;
            document.getElementById('editAddress').value = address;
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }
    </script>
}
