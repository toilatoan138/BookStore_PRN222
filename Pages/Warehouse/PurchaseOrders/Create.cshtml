@page
@model BookStore.Pages.Warehouse.PurchaseOrders.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo Đề Xuất Đơn Nhập Hàng (PO)";
    ViewData["Subtitle"] = "Chọn nhà cung cấp và lập danh sách sách cần nhập kèm số lượng & giá nhập";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="max-width: 1000px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold">Chi nhánh nhập hàng <span class="text-danger">*</span></label>
                <select asp-for="Input.BranchId" class="form-select" onchange="onBranchChange()">
                    <option value="">-- Chọn kho nhận hàng --</option>
                    @foreach (var branch in Model.Branches)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.BranchId" class="text-danger small"></span>
            </div>
            <div class="col-md-6" id="supplierBlock" style="display: none;">
                <label class="form-label fw-bold">Nhà cung cấp <span class="text-danger">*</span></label>
                <select asp-for="Input.SupplierId" class="form-select bg-light" id="globalSupplierSelect" style="pointer-events: none;" onchange="onGlobalSupplierChange()">
                    <option value="">-- Chọn Nhà cung cấp --</option>
                    @foreach (var s in Model.Suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.SupplierId" class="text-danger small"></span>
            </div>
        </div>

        <!-- ITEMS TABLE -->
        <div id="poItemsSection" style="display: none;">
            <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-list text-primary me-2"></i>Danh sách sách đề xuất nhập</h6>
            <div class="table-responsive mb-3">
                <table class="table table-bordered align-middle small" id="poItemsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50%;">Sản phẩm (Sách)</th>
                            <th style="width: 20%;">Số lượng nhập</th>
                            <th style="width: 20%;">Đơn giá (VNĐ)</th>
                            <th style="width: 10%;" class="text-center">Xóa</th>
                        </tr>
                    </thead>
                    <tbody id="poItemsBody">
                        <!-- INITIAL ROWS -->
                        @{
                            var initialRows = Model.Input.Items != null && Model.Input.Items.Count > 0 
                                ? Model.Input.Items 
                                : new List<BookStore.Pages.Warehouse.PurchaseOrders.CreateModel.PoItemRow> { new(), new(), new() };
                        }
                        @for (int i = 0; i < initialRows.Count; i++)
                        {
                            var row = initialRows[i];
                            <tr>
                                <td>
                                    <select name="Input.Items[@i].BookId" class="form-select form-select-sm book-select" onchange="onBookChange(this)">
                                        <option value="0" data-supplier-id="">-- Chọn sách --</option>
                                        @foreach (var b in Model.Books)
                                        {
                                            if (b.Id == row.BookId) {
                                                <option value="@b.Id" data-supplier-id="@b.SupplierId" data-title="@b.Title" data-total-stock="@b.StockQuantity" selected>@b.Title (Tổng tồn: @b.StockQuantity)</option>
                                            } else {
                                                <option value="@b.Id" data-supplier-id="@b.SupplierId" data-title="@b.Title" data-total-stock="@b.StockQuantity">@b.Title (Tổng tồn: @b.StockQuantity)</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="Input.Items[@i].Quantity" min="1" class="form-control form-control-sm" placeholder="SL" value="@(row.Quantity > 0 ? row.Quantity : 10)" />
                                </td>
                                <td>
                                    <input type="number" name="Input.Items[@i].UnitPrice" step="1000" min="0" class="form-control form-control-sm" placeholder="Giá nhập" value="@(row.UnitPrice > 0 ? Math.Round(row.UnitPrice) : 50000)" />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="this.closest('tr').remove()">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mb-4">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addRow()">
                    <i class="fa-solid fa-plus me-1"></i>Thêm dòng sách khác
                </button>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">
                    <i class="fa-solid fa-paper-plane me-1"></i>Gửi đề xuất PO tới Admin
                </button>
                <a asp-page="/Warehouse/PurchaseOrders/Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                    Hủy
                </a>
            </div>
        </div>
        
        <div id="branchPrompt" class="text-center py-5 bg-light rounded-3 border">
            <i class="fa-solid fa-hand-pointer fa-3x text-secondary mb-3"></i>
            <h5 class="fw-bold text-secondary">Vui lòng chọn chi nhánh</h5>
            <p class="text-muted small mb-0">Bạn cần chọn <strong>Chi nhánh nhập hàng</strong> ở phía trên trước khi tiến hành chọn sách.</p>
        </div>
    </form>
</div>

<select id="bookSelectTemplate" style="display: none;">
    <option value="0" data-supplier-id="">-- Chọn sách --</option>
    @foreach (var b in Model.Books)
    {
        <option value="@b.Id" data-supplier-id="@b.SupplierId" data-title="@b.Title" data-total-stock="@b.StockQuantity">@b.Title (Tổng tồn: @b.StockQuantity)</option>
    }
</select>

<script>
    const bookBranchStocks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookBranchStocks));
    let rowIndex = @Html.Raw(Model.Input.Items != null && Model.Input.Items.Count > 0 ? Model.Input.Items.Count : 3);

    function updateOptionsText(selectElement, branchId) {
        Array.from(selectElement.options).forEach(opt => {
            if (opt.value === "0") return;
            const bookId = opt.value;
            const title = opt.getAttribute('data-title');
            const totalStock = opt.getAttribute('data-total-stock');
            
            if (branchId && bookBranchStocks[bookId] && bookBranchStocks[bookId][branchId] !== undefined) {
                const branchStock = bookBranchStocks[bookId][branchId];
                opt.text = `${title} (Tồn tại kho: ${branchStock})`;
            } else if (branchId) {
                opt.text = `${title} (Tồn tại kho: 0)`;
            } else {
                opt.text = `${title} (Tổng tồn: ${totalStock})`;
            }
        });
    }

    function onBranchChange() {
        const branchId = document.getElementById('Input_BranchId').value;
        const poItemsSection = document.getElementById('poItemsSection');
        const branchPrompt = document.getElementById('branchPrompt');
        
        if (branchId) {
            poItemsSection.style.display = 'block';
            branchPrompt.style.display = 'none';
        } else {
            poItemsSection.style.display = 'none';
            branchPrompt.style.display = 'block';
        }
        
        // Cập nhật Template
        const templateSelect = document.getElementById('bookSelectTemplate');
        updateOptionsText(templateSelect, branchId);
        
        // Cập nhật các select đang hiển thị
        const allBookSelects = document.querySelectorAll('.book-select');
        allBookSelects.forEach(select => {
            updateOptionsText(select, branchId);
        });
    }

    function onBookChange(selectElement) {
        const selectedOption = selectElement.options[selectElement.selectedIndex];
        const supplierId = selectedOption.getAttribute('data-supplier-id');
        
        const globalSupplierSelect = document.getElementById('globalSupplierSelect');
        const supplierBlock = document.getElementById('supplierBlock');

        if (supplierId && supplierId !== "0" && supplierId !== "") {
            if (globalSupplierSelect.value !== supplierId) {
                globalSupplierSelect.value = supplierId;
                onGlobalSupplierChange();
            }
            supplierBlock.style.display = 'block';
        } else {
            // Check if all book selects are empty, if so, we can clear global supplier
            let anyBookSelected = false;
            document.querySelectorAll('.book-select').forEach(sel => {
                if(sel.value !== "0" && sel.value !== "") anyBookSelected = true;
            });
            if(!anyBookSelected) {
                globalSupplierSelect.value = "";
                supplierBlock.style.display = 'none';
                onGlobalSupplierChange();
            }
        }
    }

    function onGlobalSupplierChange() {
        const selectedSupplierId = document.getElementById('globalSupplierSelect').value;
        const allBookSelects = document.querySelectorAll('.book-select');
        const templateSelect = document.getElementById('bookSelectTemplate');
        
        allBookSelects.forEach(select => {
            const currentValue = select.value;
            // Lấy HTML từ template để reset option (bảo toàn text đã được cập nhật bởi onBranchChange)
            select.innerHTML = templateSelect.innerHTML;
            
            // Lọc ra các sách có data-supplier-id trùng với selectedSupplierId
            if (selectedSupplierId) {
                Array.from(select.options).forEach(option => {
                    if (option.value !== "0" && option.getAttribute('data-supplier-id') !== selectedSupplierId) {
                        option.style.display = 'none';
                        option.disabled = true;
                    } else {
                        option.style.display = '';
                        option.disabled = false;
                    }
                });
            }

            // Giữ lại giá trị cũ nếu hợp lệ
            let valid = false;
            Array.from(select.options).forEach(option => {
                if(option.value === currentValue && !option.disabled) valid = true;
            });
            if(valid) {
                select.value = currentValue;
            } else {
                select.value = "0";
            }
        });
    }

    // Call once to filter initially if needed
    document.addEventListener('DOMContentLoaded', () => {
        onBranchChange(); // Initialize the text based on current branch selection
        onGlobalSupplierChange();
    });

    function addRow() {
        const tbody = document.getElementById('poItemsBody');
        const templateSelect = document.getElementById('bookSelectTemplate');
        const tr = document.createElement('tr');
        
        tr.innerHTML = `
            <td>
                <select name="Input.Items[${rowIndex}].BookId" class="form-select form-select-sm book-select" onchange="onBookChange(this)">
                    ${templateSelect.innerHTML}
                </select>
            </td>
            <td>
                <input type="number" name="Input.Items[${rowIndex}].Quantity" min="1" class="form-control form-control-sm" placeholder="SL" value="10" />
            </td>
            <td>
                <input type="number" name="Input.Items[${rowIndex}].UnitPrice" step="1000" min="0" class="form-control form-control-sm" placeholder="Giá nhập" value="50000" />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="this.closest('tr').remove()">
                    <i class="fa-regular fa-trash-can"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
        rowIndex++;
        
        // Cập nhật lại filter cho dòng mới
        onGlobalSupplierChange();
    }
</script>
