@page
@model BookStore.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <partial name="_SidebarPartial" />
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h4 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-receipt text-danger me-2"></i>Đơn hàng của tôi</h4>

                <!-- STATUS FILTER TABS -->
                <div class="d-flex gap-2 overflow-auto pb-2 mb-4 border-bottom">
                    <a asp-page="/Orders/Index"
                       class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-nowrap @(!Model.Status.HasValue ? "btn-danger" : "btn-light text-dark border")">
                        Tất cả (@Model.Orders.Count)
                    </a>
                    <a asp-page="/Orders/Index" asp-route-status="Pending"
                       class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-nowrap @(Model.Status == OrderStatus.Pending ? "btn-danger" : "btn-light text-dark border")">
                        Chờ xác nhận
                    </a>
                    <a asp-page="/Orders/Index" asp-route-status="Processing"
                       class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-nowrap @(Model.Status == OrderStatus.Processing ? "btn-danger" : "btn-light text-dark border")">
                        Đang chuẩn bị hàng
                    </a>
                    <a asp-page="/Orders/Index" asp-route-status="Shipping"
                       class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-nowrap @(Model.Status == OrderStatus.Shipping ? "btn-danger" : "btn-light text-dark border")">
                        Đang giao hàng
                    </a>
                    <a asp-page="/Orders/Index" asp-route-status="Delivered"
                       class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-nowrap @(Model.Status == OrderStatus.Delivered ? "btn-danger" : "btn-light text-dark border")">
                        Đã giao thành công
                    </a>
                    <a asp-page="/Orders/Index" asp-route-status="Cancelled"
                       class="btn btn-sm rounded-pill px-3 py-2 fw-semibold text-nowrap @(Model.Status == OrderStatus.Cancelled ? "btn-danger" : "btn-light text-dark border")">
                        Đã hủy
                    </a>
                </div>

                <!-- ORDERS LIST -->
                @if (!Model.Orders.Any())
                {
                    <div class="text-center py-5 bg-light rounded-4">
                        <i class="fa-solid fa-receipt fa-4x text-muted mb-3"></i>
                        <h5 class="fw-bold text-dark">Chưa có đơn hàng nào</h5>
                        <p class="text-muted small">Bạn chưa có đơn hàng nào trong trạng thái này.</p>
                        <a asp-page="/Index" class="btn btn-danger btn-sm rounded-pill px-4">
                            Khám phá sách ngay
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var order in Model.Orders)
                        {
                            <div class="card border rounded-3 p-3">
                                <!-- ORDER HEADER -->
                                <div class="d-flex flex-wrap justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                    <div>
                                        <span class="fw-bold text-dark me-2">Mã đơn: #@order.Id</span>
                                        <span class="text-muted small">(@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</span>
                                    </div>
                                    <div>
                                        @switch (order.Status)
                                        {
                                            case OrderStatus.Pending:
                                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Chờ duyệt</span>
                                                break;
                                            case OrderStatus.Processing:
                                                <span class="badge bg-info text-dark"><i class="fa-solid fa-boxes-packing me-1"></i>Đang chuẩn bị</span>
                                                break;
                                            case OrderStatus.Shipping:
                                                <span class="badge bg-primary"><i class="fa-solid fa-truck me-1"></i>Đang giao hàng</span>
                                                break;
                                            case OrderStatus.Delivered:
                                                <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Giao thành công</span>
                                                break;
                                            case OrderStatus.Cancelled:
                                                <span class="badge bg-secondary"><i class="fa-solid fa-ban me-1"></i>Đã hủy</span>
                                                break;
                                            case OrderStatus.ReturnRequested:
                                                <span class="badge bg-danger"><i class="fa-solid fa-arrow-rotate-left me-1"></i>Yêu cầu trả hàng</span>
                                                break;
                                            default:
                                                <span class="badge bg-dark">@order.Status</span>
                                                break;
                                        }
                                    </div>
                                </div>

                                <!-- ITEMS PREVIEW -->
                                <div class="d-flex flex-column gap-2 mb-3">
                                    @foreach (var item in order.Details)
                                    {
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@(string.IsNullOrEmpty(item.Book.ImageUrl) ? "https://via.placeholder.com/40x55" : item.Book.ImageUrl)"
                                                     alt="@item.Book.Title" class="rounded border" style="width: 35px; height: 50px; object-fit: cover;" />
                                                <div>
                                                    <div class="fw-semibold small text-truncate" style="max-width: 380px;">@item.Book.Title</div>
                                                    <small class="text-muted">SL: x@item.Quantity</small>
                                                </div>
                                            </div>
                                            <div class="text-muted small">@((item.Quantity * item.Price).ToString("N0"))đ</div>
                                        </div>
                                    }
                                </div>

                                <!-- FOOTER & ACTIONS -->
                                <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 border-top">
                                    <div>
                                        <span class="text-muted small">Tổng tiền thanh toán: </span>
                                        <strong class="text-danger fs-6">@order.TotalAmount.ToString("N0")đ</strong>
                                        <small class="text-muted ms-2">(@order.PaymentMethod)</small>
                                    </div>

                                    <div class="d-flex gap-2 mt-2 mt-sm-0">
                                        <a asp-page="/Orders/Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            Xem chi tiết
                                        </a>

                                        @if (order.Status == OrderStatus.Pending || order.Status == OrderStatus.Processing)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                    onclick="openCancelModal(@order.Id)">
                                                Hủy đơn
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- CANCEL ORDER MODAL -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-ban me-2"></i>Hủy đơn hàng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Cancel">
                <input type="hidden" id="cancelOrderId" name="orderId" />
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Bạn có chắc chắn muốn hủy đơn hàng này? Vui lòng cho chúng tôi biết lý do:</p>
                    <textarea name="reason" class="form-control" rows="3" placeholder="Nhập lý do hủy đơn (ví dụ: muốn thay đổi địa chỉ, đổi sách khác...)" required></textarea>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger rounded-3 fw-bold px-4">Xác nhận hủy đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCancelModal(id) {
        document.getElementById('cancelOrderId').value = id;
        new bootstrap.Modal(document.getElementById('cancelOrderModal')).show();
    }
</script>
