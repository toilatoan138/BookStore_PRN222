@page
@model BookStore.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <partial name="_SidebarPartial" />
        </div>

        <!-- MAIN PROFILE CONTENT -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h4 class="fw-bold mb-1 text-dark">Hồ sơ cá nhân</h4>
                <p class="text-muted small mb-4">Quản lý thông tin hồ sơ và bảo mật tài khoản</p>

                <!-- MEMBERSHIP SUMMARY CARD -->
                <div class="p-4 rounded-4 mb-4" style="background: linear-gradient(135deg, #fdf2f2, #fff1f2); border: 1px solid #fecaca;">
                    <div class="row align-items-center">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="d-flex align-items-center gap-3">
                                <div class="badge-rank fs-6 px-3 py-2 rank-@Model.CurrentUser.RankName.Replace(" ", "-").ToLower()">
                                    <i class="fa-solid fa-crown me-1"></i>Hạng: @Model.CurrentUser.RankName
                                </div>
                                <span class="badge bg-danger rounded-pill px-3 py-2">
                                    Giảm giá: @((Model.CurrentUser.DiscountRate * 100).ToString("0"))%
                                </span>
                            </div>
                            <div class="mt-3 text-muted small">
                                Điểm F-Points: <strong class="text-danger fs-5">@Model.CurrentUser.FPoints.ToString("N0")</strong>
                            </div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <div class="text-muted small">Số dư ví BookStore</div>
                            <div class="fs-4 fw-bold text-success">@Model.CurrentUser.WalletBalance.ToString("N0")đ</div>
                            <a asp-page="/Account/Wallet" class="btn btn-sm btn-outline-danger mt-2 rounded-pill">
                                <i class="fa-solid fa-wallet me-1"></i>Chi tiết ví & Lịch sử
                            </a>
                        </div>
                    </div>
                </div>

                <!-- PROFILE EDIT FORM -->
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-semibold text-muted">Tên đăng nhập</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control bg-light" value="@Model.CurrentUser.UserName" readonly disabled />
                            <small class="text-muted">Tên đăng nhập không thể thay đổi</small>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.FullName" class="col-sm-3 col-form-label fw-semibold">Họ và tên</label>
                        <div class="col-sm-9">
                            <input asp-for="Input.FullName" class="form-control" />
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-semibold text-muted">Địa chỉ Email</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input type="text" class="form-control bg-light" value="@Model.CurrentUser.Email" readonly disabled />
                                <a asp-page="/Account/ChangeEmail" class="btn btn-outline-secondary">Thay đổi Email</a>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.PhoneNumber" class="col-sm-3 col-form-label fw-semibold">Số điện thoại</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input asp-for="Input.PhoneNumber" class="form-control" />
                                <a asp-page="/Account/ChangePhone" class="btn btn-outline-secondary">Đổi SĐT</a>
                            </div>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-3 col-form-label fw-semibold text-muted">Mật khẩu</label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <span class="text-muted me-3">••••••••</span>
                            <a asp-page="/Account/ChangePassword" class="btn btn-sm btn-outline-danger">
                                <i class="fa-solid fa-key me-1"></i>Đổi mật khẩu
                            </a>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-9 offset-sm-3">
                            <button type="submit" class="btn btn-danger px-4 py-2 fw-bold rounded-3">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Lưu thay đổi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
