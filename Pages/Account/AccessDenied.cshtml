@page
@model BookStore.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <i class="fa-solid fa-ban text-danger fa-4x mb-3"></i>
                <h3 class="fw-bold text-dark mb-2">Truy cập bị từ chối (403)</h3>
                <p class="text-muted mb-4">
                    Bạn không có đủ quyền hạn để truy cập vào khu vực này. Nếu bạn cho rằng đây là sự nhầm lẫn, vui lòng liên hệ ban quản trị.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-page="/Index" class="btn btn-danger px-4 py-2 rounded-3 fw-bold">
                        <i class="fa-solid fa-house me-2"></i>Về trang chủ
                    </a>
                    <a asp-page="/Account/Login" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                        Đăng nhập tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
