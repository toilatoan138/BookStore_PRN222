@page
@model BookStore.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4">
                    <h3 class="fw-bold mb-1"><i class="fa-solid fa-user-plus me-2"></i>MINDBOOK</h3>
                    <p class="mb-0 text-white-50">Tạo tài khoản thành viên mới</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label fw-semibold">Họ và tên</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-id-card text-muted"></i></span>
                                <input asp-for="Input.FullName" class="form-control border-start-0 ps-0" placeholder="VD: Nguyễn Văn A" />
                            </div>
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.UserName" class="form-label fw-semibold">Tên đăng nhập</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-user text-muted"></i></span>
                                    <input asp-for="Input.UserName" class="form-control border-start-0 ps-0" placeholder="nguyenvana" />
                                </div>
                                <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                    <input asp-for="Input.PhoneNumber" class="form-control border-start-0 ps-0" placeholder="0901234567" />
                                </div>
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold">Địa chỉ Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                <input asp-for="Input.Email" type="email" class="form-control border-start-0 ps-0" placeholder="example@email.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Password" class="form-label fw-semibold">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                                    <input asp-for="Input.Password" class="form-control border-start-0 ps-0" placeholder="Tối thiểu 6 ký tự" />
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-check-double text-muted"></i></span>
                                    <input asp-for="Input.ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Nhập lại mật khẩu" />
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-3 shadow-sm mb-3">
                            <i class="fa-solid fa-user-plus me-2"></i>Tiếp tục (Nhận mã OTP)
                        </button>

                        <div class="text-center text-muted small">
                            Đã có tài khoản? <a asp-page="/Account/Login" class="text-danger fw-bold text-decoration-none">Đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
