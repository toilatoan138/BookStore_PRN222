@page
@model BookStore.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <partial name="_SidebarPartial" />
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h4 class="fw-bold mb-1 text-dark">Đổi mật khẩu</h4>
                <p class="text-muted small mb-4">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác</p>

                <form method="post" style="max-width: 500px;">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.OldPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input asp-for="Input.OldPassword" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu hiện tại" autofocus />
                        </div>
                        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <input asp-for="Input.NewPassword" class="form-control border-start-0 ps-0" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-check-double text-muted"></i></span>
                            <input asp-for="Input.ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4 py-2 fw-bold rounded-3">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Đổi mật khẩu
                        </button>
                        <a asp-page="/Account/Profile" class="btn btn-outline-secondary px-4 py-2 rounded-3">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
