@page
@model BookStore.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4">
                    <i class="fa-solid fa-key fa-3x mb-2"></i>
                    <h4 class="fw-bold mb-1">Khôi phục mật khẩu</h4>
                    <p class="mb-0 text-white-50">Nhận mật khẩu tạm thời qua email</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    @if (Model.EmailSent)
                    {
                        <div class="text-center py-3">
                            <i class="fa-regular fa-envelope-circle-check text-success fa-4x mb-3"></i>
                            <h5 class="fw-bold text-dark">Kiểm tra hộp thư của bạn</h5>
                            <p class="text-muted small">
                                Nếu địa chỉ email tồn tại trong hệ thống, chúng tôi đã gửi mật khẩu tạm thời đến email của bạn.
                            </p>
                            <a asp-page="/Account/Login" class="btn btn-danger w-100 py-2 fw-bold rounded-3 mt-3">
                                Quay lại Đăng nhập
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-4">
                            Vui lòng nhập địa chỉ email đã đăng ký tài khoản. Hệ thống sẽ tạo mật khẩu tạm thời và gửi về email của bạn.
                        </p>

                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                            <div class="mb-4">
                                <label asp-for="Input.Email" class="form-label fw-semibold">Địa chỉ Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                    <input asp-for="Input.Email" type="email" class="form-control border-start-0 ps-0" placeholder="VD: yourname@email.com" autofocus />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-3 shadow-sm mb-3">
                                <i class="fa-solid fa-paper-plane me-2"></i>Gửi mật khẩu mới
                            </button>

                            <div class="text-center">
                                <a asp-page="/Account/Login" class="text-muted small text-decoration-none">
                                    <i class="fa-solid fa-arrow-left me-1"></i>Quay lại Đăng nhập
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
