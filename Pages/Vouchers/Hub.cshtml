@page
@model BookStore.Pages.Vouchers.HubModel
@{
    ViewData["Title"] = "Trạm Săn Voucher MindBook";
}

<div class="container py-4">
    <!-- HERO BANNER -->
    <div class="p-4 p-md-5 rounded-4 text-white text-center mb-4 shadow-sm" style="background: linear-gradient(135deg, #d97706, #b45309);">
        <i class="fa-solid fa-ticket fa-3x mb-2 text-warning"></i>
        <h2 class="display-6 fw-bold mb-1">TRẠM SĂN VOUCHER ƯU ĐÃI</h2>
        <p class="lead mb-0 text-white-50 fs-6">Lưu mã giảm giá về ví để áp dụng khi thanh toán sách hay tại MindBook!</p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-tags text-warning me-2"></i>Mã giảm giá đang phát hành</h5>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Vouchers/Wallet" class="btn btn-outline-danger btn-sm rounded-pill fw-semibold">
                <i class="fa-solid fa-wallet me-1"></i>Ví Voucher của tôi
            </a>
        }
    </div>

    @if (!Model.Vouchers.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
            <i class="fa-solid fa-ticket-simple fa-4x text-muted mb-3"></i>
            <h5 class="fw-bold text-dark">Hiện chưa có voucher mới</h5>
            <p class="text-muted small">Vui lòng quay lại sau để cập nhật các đợt phát hành mã giảm giá tiếp theo nhé!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var v in Model.Vouchers)
            {
                bool isSaved = Model.SavedVoucherIds.Contains(v.Id);
                <div class="col">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 position-relative overflow-hidden"
                         style="border-left: 6px solid #d97706 !important;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-bold fs-6">
                                @v.Code
                            </span>
                            <small class="text-muted">HSD: @v.EndDate.ToString("dd/MM/yyyy")</small>
                        </div>

                        <div class="fs-4 fw-bold text-danger mb-1">
                            @(v.DiscountPercent > 0 ? $"Giảm {v.DiscountPercent}%" : $"Giảm {v.DiscountAmount:N0}đ")
                        </div>

                        <p class="text-muted small mb-2">
                            Đơn tối thiểu: <strong>@v.MinOrderValue.ToString("N0")đ</strong>
                            @if (v.MaxDiscount.HasValue && v.MaxDiscount.Value > 0)
                            {
                                <span>(Giảm tối đa @v.MaxDiscount.Value.ToString("N0")đ)</span>
                            }
                        </p>

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Lượt dùng: @v.UsageLimit</span>

                            @if (isSaved)
                            {
                                <button class="btn btn-sm btn-secondary rounded-pill px-3" disabled>
                                    <i class="fa-solid fa-check me-1"></i>Đã lưu vào ví
                                </button>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Save" asp-route-voucherId="@v.Id">
                                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">
                                        <i class="fa-solid fa-bookmark me-1"></i>Lưu voucher
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
