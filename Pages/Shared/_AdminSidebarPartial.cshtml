@using Microsoft.AspNetCore.Identity
@using BookStore.Models.Entities
@using BookStore.Services
@inject UserManager<ApplicationUser> UserManager
@inject IWarehouseAdminService WarehouseAdminService
@{
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var currentUser = await UserManager.GetUserAsync(User);
    bool isSuperAdmin = currentUser?.BranchId == null;
    string branchName = "Trụ Sở Chính (Toàn Quốc)";
    if (!isSuperAdmin && currentUser?.BranchId != null)
    {
        var (isSuper, bId, bName) = await WarehouseAdminService.GetUserRoleInfoAsync(currentUser.Id);
        branchName = bName;
    }
}

<div class="admin-sidebar">
    <div class="sidebar-brand p-3 text-center" style="border-color: #991b1b; border-bottom: 1px solid rgba(255,255,255,0.15);">
        <div class="d-flex align-items-center justify-content-center mb-1">
            <i class="fa-solid fa-shield-halved text-warning me-2 fs-5"></i>
            <span class="fw-bold tracking-wide text-white">ADMIN PANEL</span>
        </div>
        <div class="mt-1">
            @if (isSuperAdmin)
            {
                <span class="badge bg-danger text-white border border-light shadow-sm" style="font-size: 0.72rem; padding: 4px 8px;">
                    <i class="fa-solid fa-crown text-warning me-1"></i>SUPER ADMIN (TỔNG)
                </span>
            }
            else
            {
                <span class="badge bg-info text-dark fw-bold border border-light shadow-sm" style="font-size: 0.72rem; padding: 4px 8px;">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i>@branchName
                </span>
            }
        </div>
    </div>
    
    <ul class="nav flex-column mt-2 px-2">
        <li class="nav-item">
            <a asp-page="/Admin/Index" class="nav-link @(currentPage == "/Admin/Index" ? "active" : "")">
                <i class="fa-solid fa-chart-line fa-fw"></i> Tổng quan kinh doanh
            </a>
        </li>
        
        <!-- NHÓM QUẢN LÝ KHO SÁCH & CHI NHÁNH -->
        <li class="nav-item mt-2">
            <div class="text-uppercase text-white-50 px-3 py-1 fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05em;">
                <i class="fa-solid fa-warehouse me-1 text-warning"></i>Quản Lý Kho Hàng
            </div>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Warehouses/Index" class="nav-link @(currentPage == "/Admin/Warehouses/Index" ? "active" : "")">
                <i class="fa-solid fa-gauge-high fa-fw"></i> Tổng quan kho
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Warehouses/StockMatrix" class="nav-link @(currentPage.Contains("/Admin/Warehouses/StockMatrix") ? "active" : "")">
                <i class="fa-solid fa-boxes-stacked fa-fw"></i> Ma trận tồn kho
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Warehouses/Transfer" class="nav-link @(currentPage.Contains("/Admin/Warehouses/Transfer") ? "active" : "")">
                <i class="fa-solid fa-dolly fa-fw"></i> Điều chuyển liên kho
            </a>
        </li>
        @if (isSuperAdmin)
        {
            <li class="nav-item">
                <a asp-page="/Admin/Warehouses/Branches" class="nav-link @(currentPage.Contains("/Admin/Warehouses/Branches") ? "active" : "")">
                    <i class="fa-solid fa-network-wired fa-fw"></i> Danh mục kho & Chi nhánh
                </a>
            </li>
        }
        <li class="nav-item">
            <a asp-page="/Admin/Warehouses/Reports" class="nav-link @(currentPage.Contains("/Admin/Warehouses/Reports") ? "active" : "")">
                <i class="fa-solid fa-file-waveform fa-fw"></i> Báo cáo Xuất - Nhập - Tồn
            </a>
        </li>
        @if (isSuperAdmin)
        {
            <li class="nav-item">
                <a asp-page="/Admin/Warehouses/Reconcile" class="nav-link @(currentPage.Contains("/Admin/Warehouses/Reconcile") ? "active" : "")">
                    <i class="fa-solid fa-rotate fa-fw text-warning"></i> Kiểm soát & Đồng bộ tồn
                </a>
            </li>
        }

        <!-- NHÓM QUẢN LÝ NGHIỆP VỤ BÁN HÀNG & SẢN PHẨM -->
        <li class="nav-item mt-2">
            <div class="text-uppercase text-white-50 px-3 py-1 fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05em;">
                <i class="fa-solid fa-book-open me-1 text-warning"></i>Kinh Doanh & Khách Hàng
            </div>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Products/Index" class="nav-link @(currentPage.Contains("/Admin/Products") ? "active" : "")">
                <i class="fa-solid fa-book fa-fw"></i> Quản lý sách
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Categories/Index" class="nav-link @(currentPage.Contains("/Admin/Categories") ? "active" : "")">
                <i class="fa-solid fa-layer-group fa-fw"></i> Danh mục
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Orders/Index" class="nav-link @(currentPage.Contains("/Admin/Orders") ? "active" : "")">
                <i class="fa-solid fa-receipt fa-fw"></i> Quản lý đơn hàng
            </a>
        </li>
        @if (isSuperAdmin)
        {
            <li class="nav-item">
                <a asp-page="/Admin/Users/Index" class="nav-link @(currentPage.Contains("/Admin/Users") ? "active" : "")">
                    <i class="fa-solid fa-users-gear fa-fw"></i> Quản lý người dùng
                </a>
            </li>
        }
        <li class="nav-item">
            <a asp-page="/Admin/Vouchers/Index" class="nav-link @(currentPage.Contains("/Admin/Vouchers") ? "active" : "")">
                <i class="fa-solid fa-ticket fa-fw"></i> Quản lý Voucher
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/PurchaseOrders/Index" class="nav-link @(currentPage.Contains("/Admin/PurchaseOrders") ? "active" : "")">
                <i class="fa-solid fa-file-invoice-dollar fa-fw"></i> Duyệt Đơn Nhập (PO)
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Returns/Index" class="nav-link @(currentPage.Contains("/Admin/Returns") ? "active" : "")">
                <i class="fa-solid fa-arrow-rotate-left fa-fw"></i> Yêu cầu trả hàng
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/Reports/Index" class="nav-link @(currentPage.Contains("/Admin/Reports") && !currentPage.Contains("/Admin/Warehouses") ? "active" : "")">
                <i class="fa-solid fa-chart-pie fa-fw"></i> Báo cáo doanh thu
            </a>
        </li>
        
        <li class="nav-item mt-3 pt-3 border-top border-secondary">
            <a asp-page="/Index" class="nav-link text-warning">
                <i class="fa-solid fa-arrow-left fa-fw"></i> Về cửa hàng
            </a>
        </li>
    </ul>
</div>
