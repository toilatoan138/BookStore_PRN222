<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Quản trị") - MindBook Portal</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Chart.js 4 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Global CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">

    <div class="admin-layout">
        @if (User.IsInRole("Warehouse"))
        {
            <partial name="_WarehouseSidebarPartial" />
        }
        else if (User.IsInRole("Staff") && !User.IsInRole("Admin"))
        {
            <partial name="_StaffSidebarPartial" />
        }
        else
        {
            <partial name="_AdminSidebarPartial" />
        }

        <div class="admin-content">
            <!-- Top bar -->
            <div class="admin-topbar d-flex justify-content-between align-items-center mb-4 bg-white px-4 py-3 rounded-4 shadow-sm border">
                <div>
                    <h4 class="mb-0 fw-bold text-dark d-flex align-items-center">
                        @(ViewData["Title"] ?? "Bảng điều khiển")
                    </h4>
                    @if (ViewData["Subtitle"] != null)
                    {
                        <small class="text-muted d-block mt-1">@ViewData["Subtitle"]</small>
                    }
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="fw-bold text-dark small">@User.Identity?.Name</div>
                        <div class="d-flex gap-1 justify-content-end align-items-center mt-1">
                            <span class="badge bg-danger shadow-sm" style="font-size: 0.7rem;">
                                @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Warehouse") ? "Warehouse" : "Staff")
                            </span>
                        </div>
                    </div>
                    <div class="vr h-50 my-auto text-muted"></div>
                    <form asp-page="/Account/Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" title="Đăng xuất" style="width: 36px; height: 36px;">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        </button>
                    </form>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
